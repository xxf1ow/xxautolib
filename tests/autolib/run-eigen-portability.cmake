cmake_minimum_required(VERSION 3.20)

foreach(key IN ITEMS SOURCE_ROOT INSTALL_ROOT VALIDATION_ROOT GENERATOR PLATFORM
    EIGEN_340_ARCHIVE EIGEN_340_SHA256 EIGEN_501_ARCHIVE EIGEN_501_SHA256 PRODUCER_IDENTITY CONSUMER_IDENTITY)
    if(NOT DEFINED ${key} OR "${${key}}" STREQUAL "")
        message(FATAL_ERROR "run-eigen-portability requires ${key}")
    endif()
endforeach()
foreach(key IN ITEMS SOURCE_ROOT INSTALL_ROOT VALIDATION_ROOT EIGEN_340_ARCHIVE EIGEN_501_ARCHIVE)
    get_filename_component(${key} "${${key}}" REALPATH)
endforeach()
file(RELATIVE_PATH relative "${SOURCE_ROOT}/build" "${VALIDATION_ROOT}")
if(IS_ABSOLUTE "${relative}" OR relative MATCHES "^\\.\\.(/|$)" OR relative STREQUAL "")
    message(FATAL_ERROR "VALIDATION_ROOT must be below SOURCE_ROOT/build")
endif()
foreach(label IN ITEMS 340 501)
    if(NOT EXISTS "${EIGEN_${label}_ARCHIVE}" OR IS_DIRECTORY "${EIGEN_${label}_ARCHIVE}")
        message(FATAL_ERROR "Missing Eigen archive: ${EIGEN_${label}_ARCHIVE}")
    endif()
    file(SHA256 "${EIGEN_${label}_ARCHIVE}" actual)
    string(TOLOWER "${EIGEN_${label}_SHA256}" expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "SHA256 mismatch for Eigen ${label}")
    endif()
endforeach()
if(PLATFORM STREQUAL "windows-x86_64")
    set(importer autolib-importer-windows-x86_64.exe)
elseif(PLATFORM STREQUAL "darwin-aarch64")
    set(importer autolib-importer-darwin-aarch64)
elseif(PLATFORM MATCHES "^linux-(x86_64|aarch64)$")
    set(importer "autolib-importer-${PLATFORM}")
else()
    message(FATAL_ERROR "Unsupported Eigen portability consumer: ${PLATFORM}")
endif()
set(inputs "${INSTALL_ROOT}/autolib.cmake" "${INSTALL_ROOT}/${importer}"
    "${SOURCE_ROOT}/src/dependencies/eigen/package.toml" "${PRODUCER_IDENTITY}" "${CONSUMER_IDENTITY}")
if(PCL_VERSION)
    list(APPEND inputs "${INSTALL_ROOT}/pcl/${PCL_VERSION}/autolib-import.cmake")
endif()
foreach(input IN LISTS inputs)
    if(NOT EXISTS "${input}" OR IS_DIRECTORY "${input}")
        message(FATAL_ERROR "Missing Eigen portability input: ${input}")
    endif()
endforeach()
if(PCL_VERSION AND (NOT NATIVE_TRANSPORT OR NOT EXISTS "${NATIVE_TRANSPORT}" OR IS_DIRECTORY "${NATIVE_TRANSPORT}"))
    message(FATAL_ERROR "PCL consumption requires NATIVE_TRANSPORT")
endif()
foreach(identity IN ITEMS PRODUCER_IDENTITY CONSUMER_IDENTITY)
    file(READ "${${identity}}" content)
    foreach(key IN ITEMS repository sha run_id attempt)
        string(JSON value ERROR_VARIABLE error GET "${content}" "${key}")
        if(error OR value STREQUAL "")
            message(FATAL_ERROR "${identity} requires ${key}")
        endif()
        set(${identity}_${key} "${value}")
    endforeach()
endforeach()
if(NOT EXPECTED_PRODUCER_SHA)
    set(EXPECTED_PRODUCER_SHA "${CONSUMER_IDENTITY_sha}")
endif()
if(NOT PRODUCER_IDENTITY_repository STREQUAL CONSUMER_IDENTITY_repository OR
   NOT PRODUCER_IDENTITY_sha STREQUAL EXPECTED_PRODUCER_SHA)
    message(FATAL_ERROR "Eigen producer must match the expected repository and source SHA")
endif()

string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(run "${VALIDATION_ROOT}/run-${nonce}")
set(initial "${run}/initial")
file(MAKE_DIRECTORY "${initial}")
configure_file("${PRODUCER_IDENTITY}" "${run}/producer.json" COPYONLY)
configure_file("${CONSUMER_IDENTITY}" "${run}/consumer.json" COPYONLY)
file(COPY "${INSTALL_ROOT}/autolib.cmake" "${INSTALL_ROOT}/${importer}" DESTINATION "${initial}")
if(PCL_VERSION)
    set(transport "${run}/transport")
    file(ARCHIVE_EXTRACT INPUT "${NATIVE_TRANSPORT}" DESTINATION "${transport}")
    file(READ "${transport}/transport.json" manifest)
    string(JSON count LENGTH "${manifest}" assets)
    if(count LESS 1)
        message(FATAL_ERROR "Native transport contains no package assets")
    endif()
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON asset GET "${manifest}" assets ${index} path)
        string(JSON expected GET "${manifest}" assets ${index} sha256)
        file(SHA256 "${transport}/${asset}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "SHA256 mismatch for native package ${asset}")
        endif()
        file(ARCHIVE_EXTRACT INPUT "${transport}/${asset}" DESTINATION "${initial}")
    endforeach()
    file(GLOB candidates LIST_DIRECTORIES true "${transport}/candidates/*")
    foreach(candidate IN LISTS candidates)
        get_filename_component(name "${candidate}" NAME)
        configure_file("${candidate}/package.toml" "${initial}/${name}/package.toml" COPYONLY)
    endforeach()
endif()
file(ARCHIVE_EXTRACT INPUT "${EIGEN_340_ARCHIVE}" DESTINATION "${initial}")
file(ARCHIVE_EXTRACT INPUT "${EIGEN_501_ARCHIVE}" DESTINATION "${initial}")
configure_file("${SOURCE_ROOT}/src/dependencies/eigen/package.toml" "${initial}/eigen/package.toml" COPYONLY)
file(WRITE "${run}/inputs.txt"
    "platform=${PLATFORM}\nEigen3.4.0=${EIGEN_340_ARCHIVE}\nsha256_3.4.0=${EIGEN_340_SHA256}\nEigen5.0.1=${EIGEN_501_ARCHIVE}\nsha256_5.0.1=${EIGEN_501_SHA256}\ninitial=${initial}\nrelocated=${run}/relocated\n")
set(toolchain "")
foreach(key IN ITEMS CMAKE_MAKE_PROGRAM CMAKE_C_COMPILER CMAKE_CXX_COMPILER CMAKE_OSX_ARCHITECTURES
    CMAKE_OSX_DEPLOYMENT_TARGET CMAKE_OSX_SYSROOT CMAKE_POLICY_VERSION_MINIMUM
    CMAKE_MSVC_RUNTIME_LIBRARY CMAKE_INSTALL_LIBDIR GENERATOR_PLATFORM GENERATOR_TOOLSET)
    if(DEFINED ${key})
        list(APPEND toolchain "-D${key}=${${key}}")
    endif()
endforeach()
if(PCL_VERSION)
    file(RENAME "${INSTALL_ROOT}" "${run}/native-install")
endif()
foreach(location IN ITEMS initial relocated)
    if(location STREQUAL "relocated")
        file(RENAME "${initial}" "${run}/relocated")
    endif()
    set(versions 3.4.0 5.0.1)
    if(PCL_VERSION)
        set(versions 3.4.0)
    endif()
    foreach(version IN LISTS versions)
        set(modules "eigen@${version}")
        set(roots "${modules}")
        if(PCL_VERSION)
            list(APPEND modules "pcl@${PCL_VERSION}")
            set(roots "pcl@${PCL_VERSION}")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_ROOT=${SOURCE_ROOT}"
            "-DINSTALL_ROOT=${run}/${location}" "-DVALIDATION_ROOT=${run}/consumers/${location}/${version}"
            "-DGENERATOR=${GENERATOR}" "-DMODULES=${modules}" "-DROOT_PACKAGES=${roots}"
            ${toolchain} -P "${SOURCE_ROOT}/tests/autolib/run-installed.cmake"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
        file(WRITE "${run}/${location}-${version}.log" "${output}${diagnostic}")
        if(NOT status STREQUAL "0")
            if(PCL_VERSION)
                file(RENAME "${run}/native-install" "${INSTALL_ROOT}")
            endif()
            message(FATAL_ERROR "Eigen ${version} ${location} consumption failed; see ${run}/${location}-${version}.log\n${output}${diagnostic}")
        endif()
    endforeach()
endforeach()
if(PCL_VERSION)
    file(RENAME "${run}/native-install" "${INSTALL_ROOT}")
endif()
message(STATUS "Same-archive Eigen portability: ${run}")
