cmake_minimum_required(VERSION 3.20)

foreach(key IN ITEMS SOURCE_ROOT VALIDATION_ROOT ENTRY_URL)
    if(NOT DEFINED ${key} OR "${${key}}" STREQUAL "")
        message(FATAL_ERROR "run-github requires ${key}")
    endif()
    if(NOT key STREQUAL "ENTRY_URL")
        get_filename_component(${key} "${${key}}" ABSOLUTE)
    endif()
endforeach()
file(RELATIVE_PATH relative "${SOURCE_ROOT}/build" "${VALIDATION_ROOT}")
if(IS_ABSOLUTE "${relative}" OR relative MATCHES "^\\.\\.(/|$)" OR relative STREQUAL "")
    message(FATAL_ERROR "VALIDATION_ROOT must be below ${SOURCE_ROOT}/build")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(run "${VALIDATION_ROOT}/run-${nonce}")
file(MAKE_DIRECTORY "${run}")
message(STATUS "GitHub consumer validation: ${run}")

function(run_logged label)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
    file(WRITE "${run}/${label}.log" "${output}${diagnostic}")
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "${label} failed (${status}); see ${run}/${label}.log\n${output}${diagnostic}")
    endif()
endfunction()

set(consumer "${run}/consumer")
file(MAKE_DIRECTORY "${consumer}/3rdparty")
foreach(file IN ITEMS CMakeLists.txt smoke.cpp)
    configure_file("${SOURCE_ROOT}/tests/autolib/${file}" "${consumer}/${file}" COPYONLY)
endforeach()
file(DOWNLOAD "${ENTRY_URL}" "${consumer}/3rdparty/autolib.cmake" TLS_VERIFY ON STATUS status)
list(GET status 0 code)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "entry download failed: ${ENTRY_URL}: ${status}")
endif()
if(NOT MODULES)
    set(MODULES queue lz4 flann)
    if(NOT ROOT_PACKAGES)
        set(ROOT_PACKAGES flann queue)
    endif()
elseif(NOT ROOT_PACKAGES)
    set(ROOT_PACKAGES ${MODULES})
endif()
string(REPLACE ";" "\\;" modules_argument "${MODULES}")
string(REPLACE ";" "\\;" roots_argument "${ROOT_PACKAGES}")
set(configure "${CMAKE_COMMAND}" -S "${consumer}" -B "${run}/build"
    "-DAUTOLIB_ENTRY=${consumer}/3rdparty/autolib.cmake"
    -DCMAKE_BUILD_TYPE=Release)
if(GENERATOR)
    list(APPEND configure -G "${GENERATOR}")
endif()
if(GENERATOR_PLATFORM)
    list(APPEND configure -A "${GENERATOR_PLATFORM}")
endif()
if(GENERATOR_TOOLSET)
    list(APPEND configure -T "${GENERATOR_TOOLSET}")
endif()
run_logged(configure ${configure} "-DMODULES=${modules_argument}" "-DROOT_PACKAGES=${roots_argument}")
run_logged(build "${CMAKE_COMMAND}" --build "${run}/build" --config Release)
include("${run}/build/prepared-state.cmake")
if(CMAKE_HOST_WIN32)
    set(ENV{PATH} "${AUTOLIB_FLANN_RUNTIME_DIR};$ENV{PATH}")
else()
    set(ENV{LD_LIBRARY_PATH} "${AUTOLIB_FLANN_RUNTIME_DIR}:$ENV{LD_LIBRARY_PATH}")
endif()
get_filename_component(cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
run_logged(test "${cmake_bin}/ctest" --test-dir "${run}/build" -C Release --output-on-failure)
run_logged(reconfigure ${configure} "-DMODULES=${modules_argument}" "-DROOT_PACKAGES=${roots_argument}")
