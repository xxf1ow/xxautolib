cmake_minimum_required(VERSION 3.21)

foreach(key IN ITEMS SOURCE_ROOT INSTALL_ROOT VALIDATION_ROOT GENERATOR)
    if(NOT DEFINED ${key} OR "${${key}}" STREQUAL "")
        message(FATAL_ERROR "run-example requires ${key}")
    endif()
    if(NOT key STREQUAL "GENERATOR")
        get_filename_component(${key} "${${key}}" REALPATH)
    endif()
endforeach()
file(RELATIVE_PATH relative "${SOURCE_ROOT}/build" "${VALIDATION_ROOT}")
if(IS_ABSOLUTE "${relative}" OR relative MATCHES "^\\.\\.(/|$)" OR relative STREQUAL "")
    message(FATAL_ERROR "VALIDATION_ROOT must be below SOURCE_ROOT/build")
endif()
set(packages queue/45db9a8b4431 lz4/1.10.0 flann/f9caaf609d8b)
set(inputs "${SOURCE_ROOT}/example/CMakeLists.txt" "${SOURCE_ROOT}/example/src"
    "${INSTALL_ROOT}/autolib.cmake" "${INSTALL_ROOT}/autolib-importer-darwin-aarch64")
foreach(package IN LISTS packages)
    list(APPEND inputs "${INSTALL_ROOT}/${package}/autolib-import.cmake")
    string(REGEX REPLACE "/.*" "" name "${package}")
    list(APPEND inputs "${INSTALL_ROOT}/${name}/package.toml")
endforeach()
foreach(input IN LISTS inputs)
    if(NOT EXISTS "${input}")
        message(FATAL_ERROR "Missing example input: ${input}")
    endif()
endforeach()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(run "${VALIDATION_ROOT}/run-${nonce}")
file(MAKE_DIRECTORY "${run}/example/3rdparty")
configure_file("${SOURCE_ROOT}/example/CMakeLists.txt" "${run}/example/CMakeLists.txt" COPYONLY)
file(COPY "${SOURCE_ROOT}/example/src" DESTINATION "${run}/example")
file(COPY "${INSTALL_ROOT}/autolib.cmake" "${INSTALL_ROOT}/autolib-importer-darwin-aarch64"
    DESTINATION "${run}/example/3rdparty")
foreach(package IN LISTS packages)
    string(REGEX REPLACE "/.*" "" name "${package}")
    file(COPY "${INSTALL_ROOT}/${package}" "${INSTALL_ROOT}/${name}/package.toml"
        DESTINATION "${run}/example/3rdparty/${name}")
endforeach()

function(run_logged label)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
    file(WRITE "${run}/${label}.log" "${output}${diagnostic}")
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "example ${label} failed (${status}); see ${run}/${label}.log\n${output}${diagnostic}")
    endif()
endfunction()

set(configure "${CMAKE_COMMAND}" -S "${run}/example" -B "${run}/build" -G "${GENERATOR}" -DCMAKE_BUILD_TYPE=Release)
foreach(key IN ITEMS CMAKE_MAKE_PROGRAM CMAKE_C_COMPILER CMAKE_CXX_COMPILER CMAKE_OSX_ARCHITECTURES
    CMAKE_OSX_DEPLOYMENT_TARGET CMAKE_OSX_SYSROOT CMAKE_POLICY_VERSION_MINIMUM)
    if(DEFINED ${key})
        list(APPEND configure "-D${key}=${${key}}")
    endif()
endforeach()
run_logged(configure ${configure})
run_logged(build "${CMAKE_COMMAND}" --build "${run}/build" --config Release --verbose)
run_logged(test "${run}/build/autolib_example")
file(READ "${run}/test.log" result)
foreach(name IN ITEMS queue lz4 flann)
    if(NOT result MATCHES "${name}: OK")
        message(FATAL_ERROR "example did not report ${name}: OK; see ${run}/test.log")
    endif()
endforeach()
message(STATUS "Original example validation: ${run}")
