cmake_minimum_required(VERSION 3.20)

set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_LIBDIR} "${GSTREAMER}/lib/pkgconfig")
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    foreach(module IN ITEMS glib-2.0 gio-2.0)
        execute_process(COMMAND "${PKG_CONFIG}" --print-variables "${module}"
            OUTPUT_VARIABLE variables COMMAND_ERROR_IS_FATAL ANY)
        if(variables MATCHES "(^|\n)(glib_genmarshal|gobject_query|glib_mkenums|gio|gio_querymodules|glib_compile_schemas|glib_compile_resources|gdbus|gdbus_codegen|gresource|gsettings)(\r?\n|$)")
            message(FATAL_ERROR "${module}.pc advertises a tool that the package does not ship: ${CMAKE_MATCH_2}")
        endif()
    endforeach()
endif()

execute_process(COMMAND "${PKG_CONFIG}" --modversion zlib
    OUTPUT_VARIABLE version OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${PKG_CONFIG}" --cflags --libs zlib
    OUTPUT_VARIABLE flags OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
separate_arguments(flags UNIX_COMMAND "${flags}")
if(CMAKE_HOST_WIN32)
    # pkgconf 输出的 Unix 参数保留斜杠路径，按参数转换成 MSVC 格式。
    set(include_flags "")
    set(link_flags "")
    foreach(flag IN LISTS flags)
        if(flag MATCHES "^-I(.+)$")
            list(APPEND include_flags "/I${CMAKE_MATCH_1}")
        elseif(flag MATCHES "^-L(.+)$")
            list(APPEND link_flags "/LIBPATH:${CMAKE_MATCH_1}")
        elseif(flag MATCHES "^-l(.+)$")
            list(APPEND link_flags "${CMAKE_MATCH_1}.lib")
        else()
            message(FATAL_ERROR "Unexpected zlib compiler argument: ${flag}")
        endif()
    endforeach()
    set(launcher "")
    set(ENV{PATH} "${GSTREAMER}/bin;$ENV{PATH}")
    execute_process(COMMAND "${CC}" /nologo ${include_flags} "${CMAKE_CURRENT_LIST_DIR}/gstreamer-zlib.c"
        "/Fo:${OUTPUT}.obj" "/Fe:${OUTPUT}" /link ${link_flags} COMMAND_ERROR_IS_FATAL ANY)
else()
    set(launcher "")
    set(link_flags "-Wl,-rpath,${GSTREAMER}/lib")
    if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
        set(launcher "${GSTREAMER}/bin/gst-run")
        list(APPEND link_flags -ldl)
    elseif(CMAKE_HOST_APPLE AND SDKROOT)
        if(NOT IS_ABSOLUTE "${SDKROOT}")
            execute_process(COMMAND xcrun --sdk "${SDKROOT}" --show-sdk-path
                OUTPUT_VARIABLE SDKROOT OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
        endif()
        list(APPEND link_flags -isysroot "${SDKROOT}")
    endif()
    execute_process(COMMAND "${CC}" "${CMAKE_CURRENT_LIST_DIR}/gstreamer-zlib.c" -o "${OUTPUT}"
        ${flags} ${link_flags} COMMAND_ERROR_IS_FATAL ANY)
endif()
execute_process(COMMAND ${launcher} "${OUTPUT}" "${version}"
    OUTPUT_VARIABLE loaded OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
file(REAL_PATH "${loaded}" loaded)
file(REAL_PATH "${GSTREAMER}" prefix)
cmake_path(IS_PREFIX prefix "${loaded}" NORMALIZE bundled)
if(NOT bundled)
    message(FATAL_ERROR "zlib resolved to ${loaded} outside ${prefix}")
endif()
message(STATUS "zlib ${version} loaded from ${loaded}")
