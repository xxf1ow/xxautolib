cmake_minimum_required(VERSION 3.20)

foreach(key IN ITEMS SOURCE_ROOT INSTALL_ROOT RELEASE_DIR IMPORTER_FILE TARGET_OS TARGET_ARCH GENERATOR)
    if(NOT DEFINED ${key} OR "${${key}}" STREQUAL "")
        message(FATAL_ERROR "run-local requires ${key}")
    endif()
endforeach()
if(NOT RELEASE_READY AND NOT BUILDER_FILE)
    message(FATAL_ERROR "run-local requires BUILDER_FILE when RELEASE_READY is OFF")
endif()
get_filename_component(SOURCE_ROOT "${SOURCE_ROOT}" ABSOLUTE)
get_filename_component(INSTALL_ROOT "${INSTALL_ROOT}" ABSOLUTE)
get_filename_component(RELEASE_DIR "${RELEASE_DIR}" ABSOLUTE)
if(NOT VALIDATION_ROOT)
    set(VALIDATION_ROOT "${SOURCE_ROOT}/build/validation/local-binary")
endif()
get_filename_component(VALIDATION_ROOT "${VALIDATION_ROOT}" ABSOLUTE)
if(NOT EVIDENCE_DIRECTORY)
    set(EVIDENCE_DIRECTORY "${VALIDATION_ROOT}")
endif()
get_filename_component(EVIDENCE_DIRECTORY "${EVIDENCE_DIRECTORY}" ABSOLUTE)
file(RELATIVE_PATH release_relative "${VALIDATION_ROOT}" "${RELEASE_DIR}")
if(IS_ABSOLUTE "${release_relative}" OR release_relative MATCHES "^\\.\\.(/|$)")
    message(FATAL_ERROR "RELEASE_DIR must be inside ${VALIDATION_ROOT}")
endif()
file(RELATIVE_PATH evidence_relative "${VALIDATION_ROOT}" "${EVIDENCE_DIRECTORY}")
if(IS_ABSOLUTE "${evidence_relative}" OR evidence_relative MATCHES "^\\.\\.(/|$)")
    message(FATAL_ERROR "EVIDENCE_DIRECTORY must be inside ${VALIDATION_ROOT}")
endif()
if(NOT MODULES)
    set(MODULES queue lz4 flann)
endif()
foreach(name IN LISTS MODULES)
    if(NOT name MATCHES "^[A-Za-z0-9][A-Za-z0-9_.+\\-]*$")
        message(FATAL_ERROR "invalid consumer module ${name}")
    endif()
endforeach()
list(REMOVE_DUPLICATES MODULES)
if(NOT ROOT_PACKAGES)
    set(ROOT_PACKAGES ${MODULES})
endif()
if(NOT RELEASE_READY)
    set(RELEASE_READY OFF)
endif()
if(NOT RELEASE_READY STREQUAL "ON" AND NOT RELEASE_READY STREQUAL "OFF")
    message(FATAL_ERROR "RELEASE_READY must be OFF or ON")
endif()
if(NOT CONFIGURATION)
    set(CONFIGURATION Release)
endif()
if(NOT DEFINED VALIDATION_MODE)
    set(VALIDATION_MODE relocate)
endif()
if(NOT VALIDATION_MODE MATCHES "^(single|relocate)$")
    message(FATAL_ERROR "VALIDATION_MODE must be single or relocate")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_id)
set(run "${EVIDENCE_DIRECTORY}/run-${run_id}")
file(MAKE_DIRECTORY "${run}")
message(STATUS "Local binary validation: ${run}")

function(run_logged label)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
    file(WRITE "${run}/${label}.log" "${output}${diagnostic}")
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "${label} failed (${result}); ${run}/${label}.log\n${output}${diagnostic}")
    endif()
endfunction()

function(snapshot root output)
    file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${root}" "${root}/*")
    list(SORT files)
    set(summary "")
    foreach(file IN LISTS files)
        if(IS_SYMLINK "${root}/${file}")
            file(READ_SYMLINK "${root}/${file}" digest)
        else()
            file(SHA256 "${root}/${file}" digest)
        endif()
        string(APPEND summary "${file}\t${digest}\n")
    endforeach()
    set(${output} "${summary}" PARENT_SCOPE)
endfunction()

function(snapshot_release root output)
    file(GLOB files LIST_DIRECTORIES FALSE RELATIVE "${root}" "${root}/*")
    list(SORT files)
    set(summary "")
    foreach(file IN LISTS files)
        file(SHA256 "${root}/${file}" digest)
        string(APPEND summary "${file}\t${digest}\n")
    endforeach()
    set(${output} "${summary}" PARENT_SCOPE)
endfunction()

function(snapshot_packages root output)
    set(summary "")
    foreach(name IN LISTS MODULES)
        snapshot("${root}/${name}" package_summary)
        string(APPEND summary "${name}\n${package_summary}")
    endforeach()
    set(${output} "${summary}" PARENT_SCOPE)
endfunction()

snapshot_packages("${INSTALL_ROOT}" installed_before)
set(initial_release "${run}/release-input")
set(original_release_before "")
string(TOLOWER "${CMAKE_HOST_SYSTEM_NAME}" host_os)
cmake_host_system_information(RESULT host_arch QUERY OS_PLATFORM)
string(TOLOWER "${host_arch}" host_arch)
if(host_arch MATCHES "^(amd64|x64|x86_64)$")
    set(host_arch x86_64)
elseif(host_arch MATCHES "^(arm64|aarch64)$")
    set(host_arch aarch64)
endif()
if(RELEASE_READY STREQUAL "ON")
    set(tool_asset "autolib-importer-${host_os}-${host_arch}")
    if(host_os STREQUAL "windows")
        string(APPEND tool_asset .exe)
    endif()
    set(release_assets "${tool_asset}")
    foreach(name IN LISTS MODULES)
        set(asset "${name}-${TARGET_OS}-${TARGET_ARCH}.tar.zst")
        if(EXISTS "${RELEASE_DIR}/${name}-any-any.tar.zst")
            if(EXISTS "${RELEASE_DIR}/${asset}")
                message(FATAL_ERROR "conflicting package assets for ${name}")
            endif()
            set(asset "${name}-any-any.tar.zst")
        endif()
        list(APPEND release_assets "${asset}")
    endforeach()
    snapshot("${RELEASE_DIR}" original_release_before)
    file(MAKE_DIRECTORY "${initial_release}")
    foreach(asset IN LISTS release_assets)
        if(NOT EXISTS "${RELEASE_DIR}/${asset}" OR IS_DIRECTORY "${RELEASE_DIR}/${asset}")
            message(FATAL_ERROR "RELEASE_READY=ON requires ${RELEASE_DIR}/${asset}")
        endif()
        file(COPY "${RELEASE_DIR}/${asset}" DESTINATION "${initial_release}")
    endforeach()
else()
set(package_arguments "")
foreach(name IN LISTS MODULES)
    list(APPEND package_arguments "--module=${name}")
endforeach()
run_logged(package "${BUILDER_FILE}" package "--source-root=${SOURCE_ROOT}" "--install-root=${INSTALL_ROOT}"
    "--output-root=${initial_release}" "--os=${TARGET_OS}" "--arch=${TARGET_ARCH}" "--cmake-command=${CMAKE_COMMAND}"
    "--host-os=${host_os}" "--host-arch=${host_arch}" "--importer-file=${IMPORTER_FILE}" ${package_arguments})
endif()
if(RELEASE_READY STREQUAL "ON")
    file(WRITE "${run}/release-input-sha256.txt" "${original_release_before}")
endif()
set(release "${run}/moved release")
file(RENAME "${initial_release}" "${release}")
snapshot_release("${release}" release_before)
set(consumer "${run}/consumer")
file(MAKE_DIRECTORY "${consumer}")
foreach(file IN ITEMS CMakeLists.txt smoke.cpp)
    configure_file("${SOURCE_ROOT}/tests/autolib/${file}" "${consumer}/${file}" COPYONLY)
endforeach()
configure_file("${SOURCE_ROOT}/src/autolib.cmake" "${consumer}/autolib.cmake" COPYONLY)
set(generator_args -G "${GENERATOR}")
if(GENERATOR_PLATFORM)
    list(APPEND generator_args -A "${GENERATOR_PLATFORM}")
endif()
if(GENERATOR_TOOLSET)
    list(APPEND generator_args -T "${GENERATOR_TOOLSET}")
endif()
set(cmake_default_args "")
foreach(key IN ITEMS CMAKE_INSTALL_LIBDIR CMAKE_POLICY_VERSION_MINIMUM)
    if(DEFINED ${key} AND NOT "${${key}}" STREQUAL "")
        list(APPEND cmake_default_args "-D${key}=${${key}}")
    endif()
endforeach()
string(REPLACE ";" "\\;" module_argument "${MODULES}")
string(REPLACE ";" "\\;" root_argument "${ROOT_PACKAGES}")
set(consumer_runtime_args "")
if(DEFINED CMAKE_MSVC_RUNTIME_LIBRARY AND NOT "${CMAKE_MSVC_RUNTIME_LIBRARY}" STREQUAL "")
    list(APPEND consumer_runtime_args "-DCMAKE_MSVC_RUNTIME_LIBRARY=${CMAKE_MSVC_RUNTIME_LIBRARY}")
endif()
run_logged(first-configure "${CMAKE_COMMAND}" -S "${consumer}" -B "${run}/first" ${generator_args}
    "-DAUTOLIB_ENTRY=${consumer}/autolib.cmake" "-DRELEASE_ROOT=${release}"
    "-DINSTALL_ROOT=${INSTALL_ROOT}" "-DMODULES=${module_argument}" "-DROOT_PACKAGES=${root_argument}"
    "-DCMAKE_BUILD_TYPE=${CONFIGURATION}" ${consumer_runtime_args} ${cmake_default_args})
file(READ "${run}/first/prepared-root.txt" prepared_root)
get_filename_component(prepared_root "${prepared_root}" ABSOLUTE)
run_logged(first-build "${CMAKE_COMMAND}" --build "${run}/first" --config Release --verbose)
set(original_path "$ENV{PATH}")
if(host_os STREQUAL "windows")
    if(flann IN_LIST MODULES)
        set(ENV{PATH} "${prepared_root}/flann/bin;${original_path}")
    endif()
else()
    set(ENV{LD_LIBRARY_PATH} "${prepared_root}/flann/lib:$ENV{LD_LIBRARY_PATH}")
endif()
run_logged(first-ctest "${CMAKE_CTEST_COMMAND}" --test-dir "${run}/first" -C Release -V)
snapshot_packages("${prepared_root}" prepared_before)
set(phases first)
set(final_ctest first-ctest)
set(final_packages "${prepared_root}")
if(VALIDATION_MODE STREQUAL "relocate")
set(moved "${run}/moved packages")
file(MAKE_DIRECTORY "${moved}")
foreach(name IN LISTS MODULES)
    file(RENAME "${prepared_root}/${name}" "${moved}/${name}")
endforeach()
run_logged(moved-configure "${CMAKE_COMMAND}" -S "${consumer}" -B "${run}/second" ${generator_args}
    "-DPREPARED_ROOT=${moved}" "-DINSTALL_ROOT=${INSTALL_ROOT}" "-DMODULES=${module_argument}"
    "-DCMAKE_BUILD_TYPE=${CONFIGURATION}" ${consumer_runtime_args} ${cmake_default_args})
run_logged(moved-build "${CMAKE_COMMAND}" --build "${run}/second" --config Release --verbose)
if(host_os STREQUAL "windows")
    if(flann IN_LIST MODULES)
        set(ENV{PATH} "${moved}/flann/bin;${original_path}")
    endif()
else()
    set(ENV{LD_LIBRARY_PATH} "${moved}/flann/lib")
endif()
run_logged(moved-ctest "${CMAKE_CTEST_COMMAND}" --test-dir "${run}/second" -C Release -V)
list(APPEND phases second)
set(final_ctest moved-ctest)
set(final_packages "${moved}")
endif()
snapshot_release("${release}" release_after)
if(NOT release_before STREQUAL release_after)
    message(FATAL_ERROR "Consuming packages modified the local release assets")
endif()
snapshot_packages("${final_packages}" prepared_after)
if(NOT prepared_before STREQUAL prepared_after)
    message(FATAL_ERROR "Consuming packages modified their metadata or bytes")
endif()
snapshot_packages("${INSTALL_ROOT}" installed_after)
if(NOT installed_before STREQUAL installed_after)
    message(FATAL_ERROR "Validation modified the original installation")
endif()
file(WRITE "${run}/installation-sha256.txt" "${installed_after}")
if(RELEASE_READY STREQUAL "ON")
    snapshot("${RELEASE_DIR}" original_release_after)
    if(NOT original_release_before STREQUAL original_release_after)
        message(FATAL_ERROR "Validation modified the original release directory")
    endif()
endif()
foreach(phase IN LISTS phases)
    foreach(file IN ITEMS imported-properties.txt link-inputs-Release.txt)
        file(READ "${run}/${phase}/${file}" inputs)
        string(FIND "${inputs}" "${INSTALL_ROOT}" producer_position)
        if(NOT producer_position EQUAL -1)
            message(FATAL_ERROR "${phase}/${file} retains the producer prefix")
        endif()
    endforeach()
endforeach()
if(flann IN_LIST MODULES)
    file(READ "${run}/${final_ctest}.log" runtime)
    string(FIND "${runtime}" "runtime_flann=${final_packages}/flann/" runtime_position)
    if(runtime_position EQUAL -1)
        message(FATAL_ERROR "Runtime did not report a library from the selected package: ${run}/${final_ctest}.log")
    endif()
endif()
list(LENGTH phases ctest_runs)
file(WRITE "${run}/result.txt" "PASS: selected modules ${MODULES}; mode ${VALIDATION_MODE}; original installation/release unchanged; ${ctest_runs} CTest runs 1/1; selected runtime and link inputs package-owned; package bytes unchanged.\n")
message(STATUS "Local binary validation PASS: ${run}")
