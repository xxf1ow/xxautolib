cmake_minimum_required(VERSION 3.20)

foreach(key IN ITEMS SOURCE_ROOT INSTALL_ROOT RELEASE_DIR IMPORTER_FILE BUILDER_FILE TARGET_OS TARGET_ARCH GENERATOR)
    if(NOT DEFINED ${key} OR "${${key}}" STREQUAL "")
        message(FATAL_ERROR "run-local requires ${key}")
    endif()
endforeach()
get_filename_component(SOURCE_ROOT "${SOURCE_ROOT}" ABSOLUTE)
get_filename_component(INSTALL_ROOT "${INSTALL_ROOT}" ABSOLUTE)
get_filename_component(RELEASE_DIR "${RELEASE_DIR}" ABSOLUTE)
set(validation "${SOURCE_ROOT}/build/validation/local-binary")
file(RELATIVE_PATH release_relative "${validation}" "${RELEASE_DIR}")
if(IS_ABSOLUTE "${release_relative}" OR release_relative MATCHES "^\\.\\.(/|$)")
    message(FATAL_ERROR "RELEASE_DIR must be inside ${validation}")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_id)
set(run "${validation}/run-${run_id}")
file(MAKE_DIRECTORY "${run}")
message(STATUS "Local binary validation: ${run}")

function(run_logged label)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
    file(WRITE "${run}/${label}.log" "${output}${diagnostic}")
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "${label} failed (${result}); ${run}/${label}.log\n${output}${diagnostic}")
    endif()
endfunction()

function(snapshot root output)
    file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${root}" "${root}/*")
    list(SORT files)
    set(summary "")
    foreach(file IN LISTS files)
        if(IS_SYMLINK "${root}/${file}")
            file(READ_SYMLINK "${root}/${file}" digest)
        else()
            file(SHA256 "${root}/${file}" digest)
        endif()
        string(APPEND summary "${file}\t${digest}\n")
    endforeach()
    set(${output} "${summary}" PARENT_SCOPE)
endfunction()

set(installed_before "")
foreach(name IN ITEMS queue lz4 flann)
    snapshot("${INSTALL_ROOT}/${name}" summary)
    string(APPEND installed_before "${name}\n${summary}")
endforeach()
set(initial_release "${RELEASE_DIR}/run-${run_id}")
string(TOLOWER "${CMAKE_HOST_SYSTEM_NAME}" host_os)
cmake_host_system_information(RESULT host_arch QUERY OS_PLATFORM)
string(TOLOWER "${host_arch}" host_arch)
if(host_arch MATCHES "^(amd64|x64|x86_64)$")
    set(host_arch x86_64)
elseif(host_arch MATCHES "^(arm64|aarch64)$")
    set(host_arch aarch64)
endif()
run_logged(package "${BUILDER_FILE}" package "--source-root=${SOURCE_ROOT}" "--install-root=${INSTALL_ROOT}"
    "--output-root=${initial_release}" "--os=${TARGET_OS}" "--arch=${TARGET_ARCH}" "--cmake-command=${CMAKE_COMMAND}"
    "--host-os=${host_os}" "--host-arch=${host_arch}" "--importer-file=${IMPORTER_FILE}" --module=queue --module=lz4 --module=flann)
set(installed_after "")
foreach(name IN ITEMS queue lz4 flann)
    snapshot("${INSTALL_ROOT}/${name}" summary)
    string(APPEND installed_after "${name}\n${summary}")
endforeach()
if(NOT installed_before STREQUAL installed_after)
    message(FATAL_ERROR "Packaging modified the original installation")
endif()
file(WRITE "${run}/installation-sha256.txt" "${installed_after}")
set(release "${run}/moved release")
file(RENAME "${initial_release}" "${release}")
set(consumer "${run}/consumer")
file(MAKE_DIRECTORY "${consumer}")
foreach(file IN ITEMS CMakeLists.txt smoke.cpp)
    configure_file("${SOURCE_ROOT}/tests/autolib/${file}" "${consumer}/${file}" COPYONLY)
endforeach()
configure_file("${SOURCE_ROOT}/src/autolib.cmake" "${consumer}/autolib.cmake" COPYONLY)
set(generator_args -G "${GENERATOR}")
if(GENERATOR_PLATFORM)
    list(APPEND generator_args -A "${GENERATOR_PLATFORM}")
endif()
if(GENERATOR_TOOLSET)
    list(APPEND generator_args -T "${GENERATOR_TOOLSET}")
endif()
run_logged(first-configure "${CMAKE_COMMAND}" -S "${consumer}" -B "${run}/first" ${generator_args}
    "-DAUTOLIB_ENTRY=${consumer}/autolib.cmake" "-DRELEASE_ROOT=${release}" "-DWORK_ROOT=${run}/empty work"
    "-DTARGET_OS=${TARGET_OS}" "-DTARGET_ARCH=${TARGET_ARCH}" "-DINSTALL_ROOT=${INSTALL_ROOT}" -DCMAKE_BUILD_TYPE=Release)
file(READ "${run}/first/prepared-root.txt" prepared_root)
get_filename_component(prepared_root "${prepared_root}" ABSOLUTE)
run_logged(first-build "${CMAKE_COMMAND}" --build "${run}/first" --config Release --verbose)
set(original_path "$ENV{PATH}")
if(host_os STREQUAL "windows")
    set(ENV{PATH} "${prepared_root}/flann/bin;${original_path}")
else()
    set(ENV{LD_LIBRARY_PATH} "${prepared_root}/flann/lib:$ENV{LD_LIBRARY_PATH}")
endif()
run_logged(first-ctest "${CMAKE_CTEST_COMMAND}" --test-dir "${run}/first" -C Release -V)
snapshot("${prepared_root}" prepared_before)
set(moved "${run}/moved packages")
file(RENAME "${prepared_root}" "${moved}")
run_logged(moved-configure "${CMAKE_COMMAND}" -S "${consumer}" -B "${run}/second" ${generator_args}
    "-DPREPARED_ROOT=${moved}" "-DINSTALL_ROOT=${INSTALL_ROOT}" -DCMAKE_BUILD_TYPE=Release)
run_logged(moved-build "${CMAKE_COMMAND}" --build "${run}/second" --config Release --verbose)
if(host_os STREQUAL "windows")
    set(ENV{PATH} "${moved}/flann/bin;${original_path}")
else()
    set(ENV{LD_LIBRARY_PATH} "${moved}/flann/lib")
endif()
run_logged(moved-ctest "${CMAKE_CTEST_COMMAND}" --test-dir "${run}/second" -C Release -V)
snapshot("${moved}" prepared_after)
if(NOT prepared_before STREQUAL prepared_after)
    message(FATAL_ERROR "Consuming relocated packages modified their metadata or bytes")
endif()
foreach(phase IN ITEMS first second)
    foreach(file IN ITEMS imported-properties.txt link-inputs-Release.txt)
        file(READ "${run}/${phase}/${file}" inputs)
        string(FIND "${inputs}" "${INSTALL_ROOT}" producer_position)
        if(NOT producer_position EQUAL -1)
            message(FATAL_ERROR "${phase}/${file} retains the producer prefix")
        endif()
    endforeach()
endforeach()
file(READ "${run}/moved-ctest.log" runtime)
string(FIND "${runtime}" "runtime_flann=${moved}/flann/" runtime_position)
if(runtime_position EQUAL -1)
    message(FATAL_ERROR "Runtime did not report a library from the moved package: ${run}/moved-ctest.log")
endif()
file(WRITE "${run}/result.txt" "PASS: original installation unchanged; release and prepared packages relocated; two CTest runs 1/1; runtime and link inputs package-owned; package bytes unchanged.\n")
message(STATUS "Local binary validation PASS: ${run}")
