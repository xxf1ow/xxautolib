cmake_minimum_required(VERSION 3.20)

foreach(key IN ITEMS SOURCE_ROOT INSTALL_ROOT VALIDATION_ROOT GENERATOR)
    if(NOT DEFINED ${key} OR "${${key}}" STREQUAL "")
        message(FATAL_ERROR "run-installed requires ${key}")
    endif()
    if(NOT key STREQUAL "GENERATOR")
        get_filename_component(${key} "${${key}}" ABSOLUTE)
    endif()
endforeach()
file(RELATIVE_PATH relative "${SOURCE_ROOT}/build" "${VALIDATION_ROOT}")
if(IS_ABSOLUTE "${relative}" OR relative MATCHES "^\\.\\.(/|$)" OR relative STREQUAL "")
    message(FATAL_ERROR "VALIDATION_ROOT must be below ${SOURCE_ROOT}/build")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(run "${VALIDATION_ROOT}/run-${nonce}")
file(MAKE_DIRECTORY "${run}")
message(STATUS "Installed consumer validation: ${run}")

function(run_logged label)
    cmake_parse_arguments(PARSE_ARGV 1 command "" "" "")
    execute_process(COMMAND ${command_UNPARSED_ARGUMENTS} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
    file(WRITE "${run}/${label}.log" "${output}${diagnostic}")
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "${label} failed (${status}); see ${run}/${label}.log\n${output}${diagnostic}")
    endif()
endfunction()

set(consumer "${run}/consumer")
file(MAKE_DIRECTORY "${consumer}/3rdparty")
foreach(file IN ITEMS CMakeLists.txt smoke.cpp)
    if(EXISTS "${SOURCE_ROOT}/tests/autolib/${file}")
        configure_file("${SOURCE_ROOT}/tests/autolib/${file}" "${consumer}/${file}" COPYONLY)
    endif()
endforeach()
configure_file("${SOURCE_ROOT}/src/autolib.cmake" "${consumer}/3rdparty/autolib.cmake" COPYONLY)
if(NOT ROOT_PACKAGES)
    set(ROOT_PACKAGES flann queue)
endif()
if(NOT MODULES)
    set(MODULES queue lz4 flann)
endif()
string(REPLACE ";" "\\;" modules "${MODULES}")
set(configure "${CMAKE_COMMAND}" -S "${consumer}" -B "${run}/build" -G "${GENERATOR}"
    "-DAUTOLIB_ENTRY=${consumer}/3rdparty/autolib.cmake" "-DRELEASE_ROOT=${INSTALL_ROOT}"
    "-DINSTALL_ROOT=${INSTALL_ROOT}" "-DMODULES=${modules}"
    -DAUTOLIB_REMOTE_ROOT= -DCMAKE_BUILD_TYPE=Release)
if(GENERATOR_PLATFORM)
    list(APPEND configure -A "${GENERATOR_PLATFORM}")
endif()
if(GENERATOR_TOOLSET)
    list(APPEND configure -T "${GENERATOR_TOOLSET}")
endif()
run_logged(configure ${configure} "-DROOT_PACKAGES=${ROOT_PACKAGES}")
run_logged(build "${CMAKE_COMMAND}" --build "${run}/build" --config Release --verbose)
include("${run}/build/prepared-state.cmake")
if(CMAKE_HOST_WIN32)
    if(AUTOLIB_FLANN_RUNTIME_DIR)
        set(ENV{PATH} "${AUTOLIB_FLANN_RUNTIME_DIR};$ENV{PATH}")
    endif()
elseif(AUTOLIB_FLANN_RUNTIME_DIR)
    set(ENV{LD_LIBRARY_PATH} "${AUTOLIB_FLANN_RUNTIME_DIR}")
endif()
get_filename_component(cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
run_logged(test "${cmake_bin}/ctest" --test-dir "${run}/build" -C Release -V)
