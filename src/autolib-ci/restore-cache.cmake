foreach(_required IN ITEMS RESULT_FILE SOURCE_ROOT INSTALL_ROOT PACKAGE_NAME OS ARCH)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "Cache restore requires ${_required}")
    endif()
endforeach()

if(NOT EXISTS "${RESULT_FILE}" OR IS_DIRECTORY "${RESULT_FILE}")
    message(FATAL_ERROR "Importer result is missing: ${RESULT_FILE}")
endif()
include("${RESULT_FILE}")
if(NOT AUTOLIB_PREPARED_PACKAGES STREQUAL PACKAGE_NAME)
    message(FATAL_ERROR "Importer result does not contain exactly ${PACKAGE_NAME}")
endif()
if(NOT DEFINED AUTOLIB_PACKAGE_DIR_${PACKAGE_NAME})
    message(FATAL_ERROR "Importer result has no directory for ${PACKAGE_NAME}")
endif()
set(_source "${AUTOLIB_PACKAGE_DIR_${PACKAGE_NAME}}")
if(NOT IS_DIRECTORY "${_source}")
    message(FATAL_ERROR "Importer package directory is missing: ${_source}")
endif()

set(_destination "${INSTALL_ROOT}/${PACKAGE_NAME}")
if(EXISTS "${_destination}" OR IS_SYMLINK "${_destination}")
    message(FATAL_ERROR "Cache restore destination already exists: ${_destination}")
endif()
file(MAKE_DIRECTORY "${INSTALL_ROOT}")
file(MAKE_DIRECTORY "${_destination}")
file(COPY "${_source}/" DESTINATION "${_destination}" PATTERN "autolib-import.cmake" EXCLUDE)

set(_adapter "${SOURCE_ROOT}/src/dependencies/${PACKAGE_NAME}/autolib-import.cmake")
if(NOT EXISTS "${_adapter}" OR IS_DIRECTORY "${_adapter}")
    message(FATAL_ERROR "Package adapter is missing: ${_adapter}")
endif()
file(READ "${_adapter}" _adapter_contents)
file(WRITE "${_destination}/autolib-import.cmake"
    "set(AUTOLIB_PACKAGE_NAME \"${PACKAGE_NAME}\")\nset(AUTOLIB_OS \"${OS}\")\nset(AUTOLIB_ARCH \"${ARCH}\")\n${_adapter_contents}")
