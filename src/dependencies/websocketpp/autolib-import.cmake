if(TARGET autolib::websocketpp)
    return()
endif()
if(NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/include/websocketpp/version.hpp")
    message(FATAL_ERROR "AutoLib websocketpp requires package-owned include/websocketpp/version.hpp")
endif()
# 通用头文件包可依赖平台包；importer 按消费平台核对完整闭包的身份。
if(NOT TARGET autolib::boost)
    if(NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/../boost/autolib-import.cmake")
        message(FATAL_ERROR "AutoLib websocketpp requires prepared sibling package boost")
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/../boost/autolib-import.cmake")
endif()
if(NOT TARGET autolib::boost)
    message(FATAL_ERROR "AutoLib websocketpp requires dependency target autolib::boost")
endif()
add_library(autolib::websocketpp INTERFACE IMPORTED GLOBAL)
target_include_directories(autolib::websocketpp INTERFACE "${CMAKE_CURRENT_LIST_DIR}/include")
target_link_libraries(autolib::websocketpp INTERFACE autolib::boost)
