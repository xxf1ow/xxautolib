get_filename_component(_ffmpeg_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(FFMPEG_INCLUDE_DIRS "${_ffmpeg_prefix}/include")
set(FFMPEG_LIBRARY_DIR "${_ffmpeg_prefix}/lib")
set(FFMPEG_LIBRARIES "")
set(FFMPEG_TARGETS "")

foreach(_ffmpeg_component IN ITEMS avformat avcodec swscale swresample avutil)
    set(_ffmpeg_pc "${FFMPEG_LIBRARY_DIR}/pkgconfig/lib${_ffmpeg_component}.pc")
    file(STRINGS "${_ffmpeg_pc}" _ffmpeg_version REGEX "^Version:")
    if(NOT _ffmpeg_version MATCHES "^Version:[ ]+(([0-9]+)[.][0-9]+[.][0-9]+)$")
        message(FATAL_ERROR "Missing FFmpeg component version in ${_ffmpeg_pc}")
    endif()
    set(FFMPEG_lib${_ffmpeg_component}_VERSION "${CMAKE_MATCH_1}")
    set(FFMPEG_lib${_ffmpeg_component}_FOUND TRUE)
    set(_ffmpeg_target "FFMPEG::${_ffmpeg_component}")
    if(WIN32)
        set(_ffmpeg_link "${FFMPEG_LIBRARY_DIR}/${_ffmpeg_component}.lib")
        set(_ffmpeg_runtime "${_ffmpeg_prefix}/bin/${_ffmpeg_component}-${CMAKE_MATCH_2}.dll")
    else()
        set(_ffmpeg_link "${FFMPEG_LIBRARY_DIR}/${CMAKE_SHARED_LIBRARY_PREFIX}${_ffmpeg_component}${CMAKE_SHARED_LIBRARY_SUFFIX}")
        set(_ffmpeg_runtime "${_ffmpeg_link}")
    endif()
    if(NOT EXISTS "${_ffmpeg_link}" OR NOT EXISTS "${_ffmpeg_runtime}")
        message(FATAL_ERROR "Incomplete FFmpeg component ${_ffmpeg_component} in ${_ffmpeg_prefix}")
    endif()
    if(NOT TARGET ${_ffmpeg_target})
        add_library(${_ffmpeg_target} SHARED IMPORTED GLOBAL)
        set_target_properties(${_ffmpeg_target} PROPERTIES IMPORTED_LOCATION "${_ffmpeg_runtime}"
            INTERFACE_INCLUDE_DIRECTORIES "${FFMPEG_INCLUDE_DIRS}")
        if(WIN32)
            set_target_properties(${_ffmpeg_target} PROPERTIES IMPORTED_IMPLIB "${_ffmpeg_link}")
        endif()
    endif()
    list(APPEND FFMPEG_LIBRARIES "${_ffmpeg_link}")
    list(APPEND FFMPEG_TARGETS "${_ffmpeg_target}")
endforeach()
set(FFMPEG_FOUND TRUE)
