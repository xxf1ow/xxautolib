 include(cmake/OpenCVInstallLayout.cmake)
+if(UNIX AND WITH_FFMPEG AND OPENCV_FFMPEG_USE_FIND_PACKAGE STREQUAL "FFMPEG" AND FFMPEG_DIR)
+  get_filename_component(_autolib_ffmpeg_libdir "${FFMPEG_DIR}/../.." ABSOLUTE)
+  file(RELATIVE_PATH _autolib_ffmpeg_rpath
+    "${CMAKE_INSTALL_PREFIX}/${OPENCV_LIB_INSTALL_PATH}" "${_autolib_ffmpeg_libdir}")
