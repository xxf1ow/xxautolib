+    list(APPEND CMAKE_INSTALL_RPATH "@loader_path/${_autolib_ffmpeg_rpath}")
+  else()
+    list(APPEND CMAKE_INSTALL_RPATH "$ORIGIN/${_autolib_ffmpeg_rpath}")
+  endif()
+endif()
 
