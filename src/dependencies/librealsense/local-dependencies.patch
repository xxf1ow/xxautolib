diff --git a/CMake/libusb_config.cmake b/CMake/libusb_config.cmake
index ca221ca..9dcd5cc 100644
--- a/CMake/libusb_config.cmake
+++ b/CMake/libusb_config.cmake
@@ -1,14 +1,21 @@
 if (NOT TARGET usb)
-    find_library(LIBUSB_LIB usb-1.0)
-    find_path(LIBUSB_INC libusb.h HINTS PATH_SUFFIXES libusb-1.0)
-    include(FindPackageHandleStandardArgs)
-    find_package_handle_standard_args(usb "libusb not found; using internal version" LIBUSB_LIB LIBUSB_INC)
-    if (USB_FOUND AND NOT USE_EXTERNAL_USB)
-        add_library(usb INTERFACE)
-        target_include_directories(usb INTERFACE ${LIBUSB_INC})
-        target_link_libraries(usb INTERFACE ${LIBUSB_LIB})
-    else()
-        include(CMake/external_libusb.cmake)
+    get_filename_component(AUTOLIB_USB_PREFIX "${CMAKE_INSTALL_PREFIX}/../libusb" ABSOLUTE)
+    find_library(LIBUSB_LIB NAMES usb-1.0 libusb-1.0
+        PATHS "${AUTOLIB_USB_PREFIX}/lib" NO_DEFAULT_PATH)
+    find_path(LIBUSB_INC libusb.h
+        PATHS "${AUTOLIB_USB_PREFIX}/include/libusb-1.0" NO_DEFAULT_PATH)
+    if(NOT LIBUSB_LIB OR NOT LIBUSB_INC)
+        message(FATAL_ERROR "Local libusb headers/library missing: ${AUTOLIB_USB_PREFIX}")
     endif()
+    add_library(usb INTERFACE)
+    target_include_directories(usb INTERFACE ${LIBUSB_INC})
+    target_link_libraries(usb INTERFACE ${LIBUSB_LIB})
+    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+        find_package(Threads REQUIRED)
+        find_library(AUTOLIB_UDEV_LIB NAMES udev REQUIRED)
+        target_link_libraries(usb INTERFACE ${AUTOLIB_UDEV_LIB} Threads::Threads)
+    elseif(WIN32)
+        target_link_libraries(usb INTERFACE windowsapp)
+    endif()
     install(TARGETS usb EXPORT realsense2Targets)
 endif()
