if(TARGET autolib::portaudio)
    return()
endif()
foreach(_autolib_portaudio_target IN ITEMS portaudio portaudio_static)
    if(TARGET ${_autolib_portaudio_target})
        message(FATAL_ERROR "AutoLib portaudio cannot import existing target ${_autolib_portaudio_target}; import AutoLib before other package discovery")
    endif()
endforeach()
set(portaudio_DIR "${CMAKE_CURRENT_LIST_DIR}/lib/cmake/portaudio")
if(NOT EXISTS "${portaudio_DIR}/portaudioConfig.cmake")
    message(FATAL_ERROR "AutoLib portaudio requires package-owned ${portaudio_DIR}/portaudioConfig.cmake")
endif()
get_property(_autolib_portaudio_before DIRECTORY PROPERTY IMPORTED_TARGETS)
find_package(portaudio REQUIRED CONFIG PATHS "${portaudio_DIR}" NO_DEFAULT_PATH)
get_property(_autolib_portaudio_after DIRECTORY PROPERTY IMPORTED_TARGETS)
foreach(_autolib_portaudio_target IN LISTS _autolib_portaudio_after)
    if(NOT _autolib_portaudio_target IN_LIST _autolib_portaudio_before)
        set_property(TARGET ${_autolib_portaudio_target} PROPERTY IMPORTED_GLOBAL TRUE)
    endif()
endforeach()
if(NOT TARGET portaudio)
    message(FATAL_ERROR "AutoLib portaudio Config must define portaudio")
endif()
add_library(autolib::portaudio INTERFACE IMPORTED GLOBAL)
target_link_libraries(autolib::portaudio INTERFACE portaudio)
