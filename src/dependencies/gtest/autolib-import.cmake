if(TARGET autolib::gtest)
    return()
endif()
foreach(_autolib_gtest_target IN ITEMS GTest::gtest GTest::gtest_main GTest::gmock GTest::gmock_main)
    if(TARGET ${_autolib_gtest_target})
        message(FATAL_ERROR "AutoLib gtest cannot import existing target ${_autolib_gtest_target}; import AutoLib before other package discovery")
    endif()
endforeach()
set(GTest_DIR "${CMAKE_CURRENT_LIST_DIR}/lib/cmake/GTest")
if(NOT EXISTS "${GTest_DIR}/GTestConfig.cmake")
    message(FATAL_ERROR "AutoLib gtest requires package-owned ${GTest_DIR}/GTestConfig.cmake")
endif()
get_property(_autolib_gtest_before DIRECTORY PROPERTY IMPORTED_TARGETS)
find_package(GTest REQUIRED CONFIG PATHS "${GTest_DIR}" NO_DEFAULT_PATH)
get_property(_autolib_gtest_after DIRECTORY PROPERTY IMPORTED_TARGETS)
foreach(_autolib_gtest_target IN LISTS _autolib_gtest_after)
    if(NOT _autolib_gtest_target IN_LIST _autolib_gtest_before)
        set_property(TARGET ${_autolib_gtest_target} PROPERTY IMPORTED_GLOBAL TRUE)
    endif()
endforeach()
if(NOT TARGET GTest::gtest)
    message(FATAL_ERROR "AutoLib gtest Config must define GTest::gtest")
endif()
if(NOT TARGET GTest::gtest_main)
    message(FATAL_ERROR "AutoLib gtest Config must define GTest::gtest_main")
endif()
add_library(autolib::gtest INTERFACE IMPORTED GLOBAL)
target_link_libraries(autolib::gtest INTERFACE GTest::gtest GTest::gtest_main)
