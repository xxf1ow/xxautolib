diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,46 @@
+    cmake_minimum_required(VERSION 3.20.0)
+    set(CURRENT_TARGET_NAME imgui)
+    project(${CURRENT_TARGET_NAME} LANGUAGES CXX)
+    set(CMAKE_CXX_STANDARD 17)
+    set(CMAKE_CXX_STANDARD_REQUIRED ON)
+    add_library(${CURRENT_TARGET_NAME} STATIC)
+    if (NOT DEFINED IMGUI_SOURCE_DIR OR NOT DEFINED SDL3_DIR)
+        message(FATAL_ERROR "Must set -DIMGUI_SOURCE_DIR and -DSDL3_DIR to point to your source directory")
+    endif()
+    #### >>>>> OpenGLES <<<<< ###########################################
+    if(BUILD_WITH_OPENGL_ES)
+        message(STATUS "BUILD_WITH_OPENGL_ES")
+        find_library(GLES_LIB GLESv2 REQUIRED)
+        find_library(EGL_LIB EGL REQUIRED)
+        get_filename_component(GLES_LIB_REAL ${GLES_LIB} REALPATH)
+        get_filename_component(EGL_LIB_REAL  ${EGL_LIB}  REALPATH)
+        list(APPEND THIRD_PARTY_LIBRARIES ${GLES_LIB_REAL} ${EGL_LIB_REAL})
+        install(FILES ${GLES_LIB_REAL} ${EGL_LIB_REAL} DESTINATION lib)
+        file(GLOB_RECURSE GLES_INC_LIST "/usr/include/GLES2/*.h")
+        install(FILES ${GLES_INC_LIST} DESTINATION include/GLES2)
+        target_compile_definitions(${CURRENT_TARGET_NAME} PRIVATE IMGUI_IMPL_OPENGL_ES2=)
+    endif()
+    #### >>>>> SDL3 <<<<< ###########################################
+    set(CURRENT_THIRD_PARTY SDL3)
+    set(${CURRENT_THIRD_PARTY}_DIR ${SDL3_DIR})
+    find_package(${CURRENT_THIRD_PARTY} REQUIRED)
+    get_target_property(${CURRENT_THIRD_PARTY}_INCS SDL3::Headers INTERFACE_INCLUDE_DIRECTORIES)
+    target_include_directories(${CURRENT_TARGET_NAME} PUBLIC ${${CURRENT_THIRD_PARTY}_INCS})
+    list(APPEND THIRD_PARTY_LIBRARIES SDL3::SDL3-static)
+    file(GLOB_RECURSE SDL3_INC_LIST "${${CURRENT_THIRD_PARTY}_INCS}/*.h")
+    install(FILES ${SDL3_INC_LIST} DESTINATION include/SDL3)
+    install(FILES $<TARGET_FILE:SDL3::SDL3-static> DESTINATION lib)
+    #### >>>>> ImGui <<<<< ###########################################
+    target_include_directories(${CURRENT_TARGET_NAME} PRIVATE ${IMGUI_SOURCE_DIR})
+    target_include_directories(${CURRENT_TARGET_NAME} PRIVATE ${IMGUI_SOURCE_DIR}/backends)
+    file(GLOB CURRENT_SRC_LIST "${IMGUI_SOURCE_DIR}/*.cpp")
+    list(APPEND CURRENT_SRC_LIST "${IMGUI_SOURCE_DIR}/backends/imgui_impl_sdl3.cpp")
+    list(APPEND CURRENT_SRC_LIST "${IMGUI_SOURCE_DIR}/backends/imgui_impl_opengl3.cpp")
+    target_sources(${CURRENT_TARGET_NAME} PRIVATE ${CURRENT_SRC_LIST})
+    target_link_libraries(${CURRENT_TARGET_NAME} PUBLIC ${THIRD_PARTY_LIBRARIES})
+    file(GLOB CURRENT_INC_LIST "${IMGUI_SOURCE_DIR}/*.h")
+    list(APPEND CURRENT_INC_LIST "${IMGUI_SOURCE_DIR}/backends/imgui_impl_sdl3.h")
+    list(APPEND CURRENT_INC_LIST "${IMGUI_SOURCE_DIR}/backends/imgui_impl_opengl3.h")
+    list(APPEND CURRENT_INC_LIST "${IMGUI_SOURCE_DIR}/backends/imgui_impl_opengl3_loader.h")
+    install(FILES ${CURRENT_INC_LIST} DESTINATION include/ImGui)
+    install(TARGETS ${CURRENT_TARGET_NAME} ARCHIVE DESTINATION lib)
