if(TARGET autolib::boost)
    return()
endif()
foreach(_autolib_boost_target IN ITEMS Boost::system Boost::filesystem Boost::thread Boost::date_time Boost::iostreams Boost::serialization Boost::chrono Boost::regex Boost::headers Boost::boost)
    if(TARGET ${_autolib_boost_target})
        message(FATAL_ERROR "AutoLib boost cannot import existing target ${_autolib_boost_target}; import AutoLib before other package discovery")
    endif()
endforeach()
set(_autolib_boost_os "${AUTOLIB_OS}")
set(_autolib_boost_arch "${AUTOLIB_ARCH}")
if(NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/../zlib/autolib-import.cmake")
    message(FATAL_ERROR "AutoLib boost requires prepared sibling package zlib")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/../zlib/autolib-import.cmake")
if(NOT AUTOLIB_PACKAGE_NAME STREQUAL "zlib" OR NOT AUTOLIB_OS STREQUAL _autolib_boost_os OR NOT AUTOLIB_ARCH STREQUAL _autolib_boost_arch)
    message(FATAL_ERROR "AutoLib boost sibling zlib has mismatched package identity")
endif()
set(Boost_DIR "${CMAKE_CURRENT_LIST_DIR}/lib/cmake/Boost-1.87.0")
if(NOT EXISTS "${Boost_DIR}/BoostConfig.cmake")
    message(FATAL_ERROR "AutoLib boost requires package-owned ${Boost_DIR}/BoostConfig.cmake")
endif()
get_property(_autolib_boost_before DIRECTORY PROPERTY IMPORTED_TARGETS)
find_package(Boost REQUIRED CONFIG COMPONENTS system filesystem thread date_time iostreams serialization chrono regex PATHS "${Boost_DIR}" NO_DEFAULT_PATH)
get_property(_autolib_boost_after DIRECTORY PROPERTY IMPORTED_TARGETS)
foreach(_autolib_boost_target IN LISTS _autolib_boost_after)
    if(NOT _autolib_boost_target IN_LIST _autolib_boost_before)
        set_property(TARGET ${_autolib_boost_target} PROPERTY IMPORTED_GLOBAL TRUE)
    endif()
endforeach()
if(NOT TARGET Boost::system)
    message(FATAL_ERROR "AutoLib boost Config must define Boost::system")
endif()
if(NOT TARGET Boost::filesystem)
    message(FATAL_ERROR "AutoLib boost Config must define Boost::filesystem")
endif()
if(NOT TARGET Boost::thread)
    message(FATAL_ERROR "AutoLib boost Config must define Boost::thread")
endif()
if(NOT TARGET Boost::date_time)
    message(FATAL_ERROR "AutoLib boost Config must define Boost::date_time")
endif()
if(NOT TARGET Boost::iostreams)
    message(FATAL_ERROR "AutoLib boost Config must define Boost::iostreams")
endif()
if(NOT TARGET Boost::serialization)
    message(FATAL_ERROR "AutoLib boost Config must define Boost::serialization")
endif()
if(NOT TARGET Boost::chrono)
    message(FATAL_ERROR "AutoLib boost Config must define Boost::chrono")
endif()
if(NOT TARGET Boost::regex)
    message(FATAL_ERROR "AutoLib boost Config must define Boost::regex")
endif()
add_library(autolib::boost INTERFACE IMPORTED GLOBAL)
target_link_libraries(autolib::boost INTERFACE Boost::system Boost::filesystem Boost::thread Boost::date_time Boost::iostreams Boost::serialization Boost::chrono Boost::regex autolib::zlib)
