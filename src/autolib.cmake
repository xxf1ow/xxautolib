include_guard(GLOBAL)
cmake_policy(PUSH)
cmake_policy(VERSION 3.20)

set(_autolib_release_root "")
file(REAL_PATH "${CMAKE_CURRENT_LIST_FILE}" _autolib_entry)
get_filename_component(_autolib_cache "${_autolib_entry}" DIRECTORY)
if(_autolib_cache MATCHES ";")
    message(FATAL_ERROR "AutoLib cache root must not contain semicolons: ${_autolib_cache}")
endif()
set_property(GLOBAL PROPERTY _AUTOLIB_CACHE_ROOT "${_autolib_cache}")
set_property(GLOBAL PROPERTY _AUTOLIB_RELEASE_ROOT "${_autolib_release_root}")
unset(_autolib_release_root)
unset(_autolib_entry)
unset(_autolib_cache)

function(_autolib_platform output value kind)
    string(TOLOWER "${value}" value)
    if(kind STREQUAL "arch")
        if(value MATCHES "^(amd64|x64|x86_64)$")
            set(value x86_64)
        elseif(value MATCHES "^(arm64|aarch64)$")
            set(value aarch64)
        else()
            message(FATAL_ERROR "AutoLib unsupported or unknown architecture '${value}'; configure the CMake target architecture")
        endif()
    elseif(NOT value MATCHES "^(windows|linux)$")
        message(FATAL_ERROR "AutoLib unsupported or unknown OS '${value}'; configure the CMake target OS")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(_autolib_metadata_source remote repository_output download_output)
    if(NOT remote MATCHES "^https://([^/]+)/([A-Za-z0-9][A-Za-z0-9_.-]*)/([A-Za-z0-9][A-Za-z0-9_.-]*)/releases/download/([^/?#]+)$")
        message(FATAL_ERROR "AutoLib expected a public GitHub or Gitee Release download root: ${remote}")
    endif()
    string(TOLOWER "${CMAKE_MATCH_1}" host)
    set(base "https://${host}/${CMAKE_MATCH_2}/${CMAKE_MATCH_3}")
    set(rest "${CMAKE_MATCH_4}")
    if(NOT host MATCHES "^(github[.]com|gitee[.]com)$")
        message(FATAL_ERROR "AutoLib unsupported metadata host: ${host}")
    endif()
    set(tag "")
    while(NOT rest STREQUAL "")
        if(rest MATCHES "^%([0-9A-Fa-f][0-9A-Fa-f])(.*)$")
            math(EXPR byte "0x${CMAKE_MATCH_1}")
            set(rest "${CMAKE_MATCH_2}")
            if(byte EQUAL 0)
                message(FATAL_ERROR "AutoLib invalid Release tag: ${remote}")
            endif()
            string(ASCII ${byte} character)
        else()
            string(SUBSTRING "${rest}" 0 1 character)
            string(SUBSTRING "${rest}" 1 -1 rest)
            if(character STREQUAL "%")
                message(FATAL_ERROR "AutoLib invalid Release tag encoding: ${remote}")
            endif()
        endif()
        string(APPEND tag "${character}")
    endwhile()
    # Unicode spaces and controls are invalid even when percent encoded.
    string(HEX "${tag}" bytes)
    if(bytes MATCHES "^([0-9a-f][0-9a-f])*(c2[89][0-9a-f]|c2a0|e19a80|e2808[0-9a]|e280a[89f]|e2819f|e38080)")
        message(FATAL_ERROR "AutoLib invalid Release tag: ${remote}")
    endif()
    string(REGEX MATCHALL ".." bytes "${bytes}")
    set(encoded "")
    foreach(hex IN LISTS bytes)
        math(EXPR byte "0x${hex}")
        if(byte LESS_EQUAL 32 OR byte EQUAL 127)
            message(FATAL_ERROR "AutoLib invalid Release tag: ${remote}")
        endif()
        string(ASCII ${byte} character)
        if(character MATCHES "^[A-Za-z0-9_.~$&+:=@-]$")
            string(APPEND encoded "${character}")
        else()
            string(TOUPPER "${hex}" hex)
            string(APPEND encoded "%${hex}")
        endif()
    endforeach()
    set(${repository_output} "${base}.git" PARENT_SCOPE)
    set(${download_output} "${base}/releases/download/${encoded}" PARENT_SCOPE)
endfunction()

function(_autolib_check_metadata_repository snapshot git)
    # Read the NUL-delimited listing as bytes: CMake strings cannot retain NULs.
    set(listing "${snapshot}/../tree.bin")
    execute_process(COMMAND "${git}" -C "${snapshot}" ls-tree -r -z HEAD
        OUTPUT_FILE "${listing}" RESULT_VARIABLE status ERROR_VARIABLE diagnostic)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "AutoLib cannot list metadata repository ${snapshot}: ${diagnostic}")
    endif()
    file(READ "${listing}" tree HEX)
    string(LENGTH "${tree}" length)
    set(offset 0)
    set(record "")
    string(ASCII 9 tab)
    while(offset LESS length)
        string(SUBSTRING "${tree}" ${offset} 2 hex)
        math(EXPR offset "${offset} + 2")
        math(EXPR byte "0x${hex}")
        if(NOT byte EQUAL 0)
            if((byte LESS 32 AND NOT byte EQUAL 9) OR byte GREATER 126 OR byte EQUAL 59)
                message(FATAL_ERROR "AutoLib metadata repository has an invalid path byte: ${snapshot}")
            endif()
            string(ASCII ${byte} character)
            string(APPEND record "${character}")
            continue()
        endif()
        if(NOT record MATCHES "^(100644|100755) blob [0-9a-f]+${tab}([^${tab}]+)$")
            message(FATAL_ERROR "AutoLib metadata repository requires regular blobs: ${snapshot}")
        endif()
        set(path "${CMAKE_MATCH_2}")
        set(record "")
        if(path STREQUAL "README.md" OR path STREQUAL "LICENSE" OR path STREQUAL ".autolib-repository.json")
            # Fixed repository files.
        elseif(path MATCHES "^autolib-importer/autolib-importer-(windows-(x86_64|aarch64)[.]exe|linux-(x86_64|aarch64))[.]tar[.]xz[.]sha256$")
            # Independent tool digests.
        elseif(path MATCHES "^([^/]+)/([^/]+)/([^/]+)$")
            set(name "${CMAKE_MATCH_1}")
            set(version "${CMAKE_MATCH_2}")
            set(asset "${CMAKE_MATCH_3}")
            _autolib_identifier("${name}" name)
            _autolib_identifier("${version}" version)
            set(valid FALSE)
            foreach(platform IN ITEMS windows-x86_64 windows-aarch64 linux-x86_64 linux-aarch64 any-any)
                if(asset STREQUAL "${name}-${version}-${platform}.tar.zst.sha256")
                    set(valid TRUE)
                endif()
            endforeach()
            if(NOT valid OR name STREQUAL "tools" OR name STREQUAL "autolib-importer")
                message(FATAL_ERROR "AutoLib invalid metadata asset path: ${path}")
            endif()
        elseif(path MATCHES "^([^/]+)/package[.]toml$")
            set(name "${CMAKE_MATCH_1}")
            _autolib_identifier("${name}" name)
            if(name STREQUAL "tools" OR name STREQUAL "autolib-importer")
                message(FATAL_ERROR "AutoLib invalid metadata package path: ${path}")
            endif()
        else()
            message(FATAL_ERROR "AutoLib unexpected metadata repository path: ${path}")
        endif()
        string(REPLACE "/" ";" components "${path}")
        set(prefix "")
        foreach(component IN LISTS components)
            string(APPEND prefix "${component}")
            string(TOLOWER "${prefix}" folded)
            string(SHA256 key "${folded}")
            if(DEFINED seen_${key} AND NOT "${seen_${key}}" STREQUAL "${prefix}")
                message(FATAL_ERROR "AutoLib case-colliding metadata path: ${path}")
            endif()
            set(seen_${key} "${prefix}")
            string(APPEND prefix "/")
        endforeach()
    endwhile()
    if(NOT record STREQUAL "")
        message(FATAL_ERROR "AutoLib unterminated metadata tree listing: ${snapshot}")
    endif()
    set(identity "${snapshot}/.autolib-repository.json")
    if(NOT EXISTS "${identity}" OR IS_DIRECTORY "${identity}")
        message(FATAL_ERROR "AutoLib metadata repository identity is missing: ${identity}")
    endif()
    file(READ "${identity}" document)
    foreach(field IN ITEMS type schema upstream)
        string(JSON kind ERROR_VARIABLE error TYPE "${document}" "${field}")
        if(error)
            message(FATAL_ERROR "AutoLib invalid metadata repository identity ${identity}: ${error}")
        endif()
        string(JSON value GET "${document}" "${field}")
        if((field STREQUAL "type" AND (NOT kind STREQUAL "STRING" OR NOT value STREQUAL "xxautolib-artifacts")) OR
           (field STREQUAL "schema" AND (NOT kind STREQUAL "NUMBER" OR NOT value STREQUAL "1")) OR
           (field STREQUAL "upstream" AND (NOT kind STREQUAL "STRING" OR NOT value STREQUAL "https://github.com/xxf1ow/xxautolib")))
            message(FATAL_ERROR "AutoLib metadata repository identity ${field} mismatch: ${identity}")
        endif()
    endforeach()
endfunction()

function(_autolib_metadata_snapshot output remote work)
    get_property(snapshot GLOBAL PROPERTY _AUTOLIB_METADATA_ROOT)
    if(NOT "${snapshot}" STREQUAL "")
        get_property(source GLOBAL PROPERTY _AUTOLIB_METADATA_SOURCE)
        if(NOT source STREQUAL remote)
            message(FATAL_ERROR "AutoLib metadata source changed during configure: ${remote}")
        endif()
        if(NOT IS_DIRECTORY "${snapshot}")
            message(FATAL_ERROR "AutoLib checked metadata snapshot is missing: ${snapshot}; configure again")
        endif()
        set(${output} "${snapshot}" PARENT_SCOPE)
        return()
    endif()
    _autolib_metadata_source("${remote}" repository download)
    find_package(Git REQUIRED)
    include(FetchContent)
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    set(root "${work}/.metadata-${nonce}")
    set(snapshot "${root}/source")
    # The declaration form preserves an explicitly empty submodule list.
    FetchContent_Declare(autolib_metadata_${nonce}
        GIT_REPOSITORY "${repository}" GIT_TAG HEAD GIT_SHALLOW TRUE GIT_SUBMODULES ""
        SOURCE_DIR "${snapshot}" BINARY_DIR "${root}/binary" SUBBUILD_DIR "${root}/subbuild")
    # Every configure needs a fresh snapshot, independently of other dependencies.
    set(FETCHCONTENT_FULLY_DISCONNECTED FALSE)
    cmake_policy(PUSH)
    if(POLICY CMP0169)
        cmake_policy(SET CMP0169 OLD)
    endif()
    FetchContent_Populate(autolib_metadata_${nonce})
    cmake_policy(POP)
    _autolib_check_metadata_repository("${snapshot}" "${GIT_EXECUTABLE}")
    set_property(GLOBAL PROPERTY _AUTOLIB_METADATA_ROOT "${snapshot}")
    set_property(GLOBAL PROPERTY _AUTOLIB_METADATA_SOURCE "${remote}")
    set(${output} "${snapshot}" PARENT_SCOPE)
endfunction()

function(_autolib_bootstrap_importer output name cache remote work)
    set(tool "${cache}/${name}")
    if(EXISTS "${tool}" OR IS_SYMLINK "${tool}")
        if(IS_DIRECTORY "${tool}" OR IS_SYMLINK "${tool}")
            message(FATAL_ERROR "AutoLib cached importer must be a regular program: ${tool}")
        endif()
        set(${output} "${tool}" PARENT_SCOPE)
        return()
    endif()
    if("${remote}" STREQUAL "")
        message(FATAL_ERROR "AutoLib importer missing from entry root: ${name}; remote source is disabled")
    endif()
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    set(staging "${cache}/.tool-${nonce}")
    _autolib_metadata_snapshot(metadata "${remote}" "${work}")
    set(digest_file "${metadata}/autolib-importer/${name}.tar.xz.sha256")
    if(NOT EXISTS "${digest_file}" OR IS_DIRECTORY "${digest_file}" OR IS_SYMLINK "${digest_file}")
        message(FATAL_ERROR "AutoLib importer requires a regular SHA256 file: ${digest_file}")
    endif()
    file(READ "${digest_file}" digest)
    string(REGEX REPLACE "^[ \t\r\n]+|[ \t\r\n]+$" "" digest "${digest}")
    string(LENGTH "${digest}" length)
    if(NOT length EQUAL 64 OR NOT digest MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "AutoLib importer archive requires one lowercase SHA256: ${digest_file}")
    endif()
    _autolib_metadata_source("${remote}" repository download)
    set(url "${download}/${name}.tar.xz")
    file(MAKE_DIRECTORY "${staging}")
    set(archive "${staging}/download.tar.xz")
    file(DOWNLOAD "${url}" "${archive}" TLS_VERIFY ON TIMEOUT 300 STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
        file(REMOVE_RECURSE "${staging}")
        message(FATAL_ERROR "AutoLib importer download failed: ${url}: ${status}")
    endif()
    file(SHA256 "${archive}" actual)
    if(NOT actual STREQUAL digest)
        file(REMOVE_RECURSE "${staging}")
        message(FATAL_ERROR "AutoLib importer archive SHA256 mismatch: ${url}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${archive}"
        RESULT_VARIABLE status OUTPUT_VARIABLE members ERROR_VARIABLE diagnostic)
    if(NOT status STREQUAL "0" OR NOT "${diagnostic}" STREQUAL "" OR NOT members STREQUAL "${name}\n")
        file(REMOVE_RECURSE "${staging}")
        message(FATAL_ERROR "AutoLib importer archive must contain only the program ${name}: ${archive}\n${diagnostic}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tvf "${archive}"
        RESULT_VARIABLE status OUTPUT_VARIABLE details ERROR_VARIABLE diagnostic)
    if(NOT status STREQUAL "0" OR NOT "${diagnostic}" STREQUAL "" OR NOT details MATCHES "^-")
        file(REMOVE_RECURSE "${staging}")
        message(FATAL_ERROR "AutoLib importer archive member must be a regular program: ${archive}\n${diagnostic}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${archive}"
        WORKING_DIRECTORY "${staging}" RESULT_VARIABLE status ERROR_VARIABLE diagnostic)
    # CMake can report truncated input on stderr while returning zero.
    if(NOT status STREQUAL "0" OR NOT "${diagnostic}" STREQUAL "")
        file(REMOVE_RECURSE "${staging}")
        message(FATAL_ERROR "AutoLib importer archive extraction failed: ${archive}\n${diagnostic}")
    endif()
    if(NOT EXISTS "${staging}/${name}" OR IS_DIRECTORY "${staging}/${name}" OR IS_SYMLINK "${staging}/${name}")
        file(REMOVE_RECURSE "${staging}")
        message(FATAL_ERROR "AutoLib importer archive is missing regular program ${name}: ${archive}")
    endif()
    if(NOT CMAKE_HOST_WIN32)
        file(CHMOD "${staging}/${name}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E rename "${staging}/${name}" "${tool}" RESULT_VARIABLE status ERROR_VARIABLE diagnostic)
    file(REMOVE_RECURSE "${staging}")
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "AutoLib cannot cache importer ${tool}: ${diagnostic}")
    endif()
    set(${output} "${tool}" PARENT_SCOPE)
endfunction()

function(_autolib_identifier value kind)
    string(TOUPPER "${value}" upper)
    string(REGEX REPLACE "\\..*$" "" stem "${upper}")
    if(NOT value MATCHES "^[A-Za-z0-9][A-Za-z0-9_.+\\-]*$" OR value MATCHES "\\.$" OR stem MATCHES "^(CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])$" OR (kind STREQUAL "version" AND upper STREQUAL "PACKAGE.TOML"))
        message(FATAL_ERROR "AutoLib invalid package ${kind}: '${value}'")
    endif()
endfunction()

function(_autolib_package_reference reference name_output version_output)
    if(NOT reference MATCHES "^([^@]+)(@([^@]+))?$")
        message(FATAL_ERROR "AutoLib invalid package reference: '${reference}'")
    endif()
    set(name "${CMAKE_MATCH_1}")
    set(version "${CMAKE_MATCH_3}")
    _autolib_identifier("${name}" name)
    if(NOT "${version}" STREQUAL "")
        _autolib_identifier("${version}" version)
    endif()
    set(${name_output} "${name}" PARENT_SCOPE)
    set(${version_output} "${version}" PARENT_SCOPE)
endfunction()

function(_autolib_validate_package name version directory cache target_os target_arch dependencies_output)
    _autolib_identifier("${name}" name)
    _autolib_identifier("${version}" version)
    set(expected "${cache}/${name}/${version}")
    if(NOT IS_ABSOLUTE "${directory}" OR directory MATCHES ";" OR NOT directory STREQUAL expected OR NOT EXISTS "${directory}/autolib-import.cmake" OR IS_DIRECTORY "${directory}/autolib-import.cmake")
        message(FATAL_ERROR "AutoLib importer returned invalid package directory: ${directory}; expected ${expected}")
    endif()
    file(REAL_PATH "${directory}/autolib-import.cmake" actual)
    if(NOT actual STREQUAL "${expected}/autolib-import.cmake")
        message(FATAL_ERROR "AutoLib package directory escapes its entry cache location: ${directory}")
    endif()
    file(GLOB entries RELATIVE "${cache}/${name}" "${cache}/${name}/*")
    set(folded_versions)
    foreach(entry IN LISTS entries)
        if(entry STREQUAL "package.toml")
            continue()
        endif()
        string(TOLOWER "${entry}" folded)
        if(folded IN_LIST folded_versions)
            message(FATAL_ERROR "AutoLib case-colliding package versions in ${cache}/${name}: ${entry}")
        endif()
        list(APPEND folded_versions "${folded}")
    endforeach()
    file(READ "${directory}/autolib-import.cmake" header)
    if(NOT header MATCHES "^set\\(AUTOLIB_PACKAGE_NAME \"([^\"]*)\"\\)\r?\nset\\(AUTOLIB_PACKAGE_VERSION \"([^\"]*)\"\\)\r?\nset\\(AUTOLIB_OS \"([^\"]*)\"\\)\r?\nset\\(AUTOLIB_ARCH \"([^\"]*)\"\\)\r?\nset\\(AUTOLIB_DEPENDENCIES \"([^\"]*)\"\\)(\r?\n|$)")
        message(FATAL_ERROR "AutoLib package metadata requires fixed name/version/os/arch/dependencies header: ${directory}")
    endif()
    set(actual_name "${CMAKE_MATCH_1}")
    set(actual_version "${CMAKE_MATCH_2}")
    set(actual_os "${CMAKE_MATCH_3}")
    set(actual_arch "${CMAKE_MATCH_4}")
    set(dependencies "${CMAKE_MATCH_5}")
    if(NOT actual_name STREQUAL name OR NOT actual_version STREQUAL version OR NOT ((actual_os STREQUAL target_os AND actual_arch STREQUAL target_arch) OR (actual_os STREQUAL "any" AND actual_arch STREQUAL "any")))
        message(FATAL_ERROR "AutoLib package metadata identity differs from result or target: ${name}@${version} in ${directory}")
    endif()
    set(${dependencies_output} "${dependencies}" PARENT_SCOPE)
endfunction()

function(autolib_import)
    if(ARGC LESS 4 OR NOT ARGV0 STREQUAL "TARGET" OR NOT ARGV2 MATCHES "^(PRIVATE|PUBLIC|INTERFACE)$")
        message(FATAL_ERROR "Usage: autolib_import(TARGET <existing target> <PRIVATE|PUBLIC|INTERFACE> <packages...>); legacy source and platform arguments are not supported")
    endif()
    set(consumer "${ARGV1}")
    set(visibility "${ARGV2}")
    if(NOT TARGET "${consumer}")
        message(FATAL_ERROR "AutoLib consumer target does not exist: ${consumer}")
    endif()
    set(packages)
    set(request_names)
    set(reused_packages)
    set(need_prepare FALSE)
    math(EXPR last "${ARGC} - 1")
    foreach(index RANGE 3 ${last})
        set(reference "${ARGV${index}}")
        _autolib_package_reference("${reference}" name version)
        if(name MATCHES "^(TARGET|PRIVATE|PUBLIC|INTERFACE|LOCAL_ROOT|REMOTE_ROOT|PACKAGES|WORK_ROOT|TARGET_OS|TARGET_ARCH|URI)$")
            message(FATAL_ERROR "AutoLib invalid package or unsupported argument: '${reference}'")
        endif()
        get_property(loaded GLOBAL PROPERTY "_AUTOLIB_LOADED_VERSION_${name}")
        if(NOT "${loaded}" STREQUAL "" AND NOT "${version}" STREQUAL "" AND NOT loaded STREQUAL version)
            message(FATAL_ERROR "AutoLib version conflict for ${name}: loaded ${loaded}, requested ${version}")
        endif()
        if("${loaded}" STREQUAL "")
            set(need_prepare TRUE)
        else()
            get_property(closure GLOBAL PROPERTY "_AUTOLIB_PACKAGE_CLOSURE_${name}")
            list(APPEND reused_packages ${closure})
        endif()
        list(APPEND packages "${reference}")
        list(APPEND request_names "${name}")
    endforeach()
    list(REMOVE_DUPLICATES packages)
    get_property(remote GLOBAL PROPERTY _AUTOLIB_RELEASE_ROOT)
    get_property(cache GLOBAL PROPERTY _AUTOLIB_CACHE_ROOT)
    get_filename_component(work "${CMAKE_BINARY_DIR}/autolib" ABSOLUTE)
    string(REPLACE "\\" "/" work "${work}")
    if(work MATCHES ";")
        message(FATAL_ERROR "AutoLib WORK_ROOT must not contain semicolons: ${work}")
    endif()
    set(target_cpu "${CMAKE_SYSTEM_PROCESSOR}")
    if(CMAKE_GENERATOR_PLATFORM)
        string(REGEX REPLACE ",.*$" "" target_cpu "${CMAKE_GENERATOR_PLATFORM}")
    endif()
    _autolib_platform(target_os "${CMAKE_SYSTEM_NAME}" os)
    _autolib_platform(target_arch "${target_cpu}" arch)
    set(identity "${cache};${target_os};${target_arch}")
    get_property(previous GLOBAL PROPERTY _AUTOLIB_CONFIGURE_IDENTITY)
    if(previous AND NOT "${previous}" STREQUAL "${identity}")
        message(FATAL_ERROR "AutoLib requires the same entry root and target platform throughout one configure")
    endif()
    set_property(GLOBAL PROPERTY _AUTOLIB_CONFIGURE_IDENTITY "${identity}")
    if(NOT need_prepare)
        list(REMOVE_DUPLICATES reused_packages)
        foreach(name IN LISTS reused_packages)
            get_property(directory GLOBAL PROPERTY "_AUTOLIB_PACKAGE_DIR_${name}")
            get_property(version GLOBAL PROPERTY "_AUTOLIB_LOADED_VERSION_${name}")
            set(AUTOLIB_PACKAGE_DIR_${name} "${directory}" PARENT_SCOPE)
            set(AUTOLIB_PACKAGE_VERSION_${name} "${version}" PARENT_SCOPE)
        endforeach()
        set(targets)
        list(REMOVE_DUPLICATES request_names)
        foreach(name IN LISTS request_names)
            list(APPEND targets "autolib::${name}")
        endforeach()
        target_link_libraries("${consumer}" ${visibility} ${targets})
        foreach(name IN LISTS reused_packages)
            get_property(version GLOBAL PROPERTY "_AUTOLIB_LOADED_VERSION_${name}")
            message(STATUS "[Info] [${consumer}] ${name} : ${version}")
        endforeach()
        set(AUTOLIB_PREPARED_PACKAGES "${reused_packages}" PARENT_SCOPE)
        return()
    endif()
    _autolib_platform(host_os "${CMAKE_HOST_SYSTEM_NAME}" os)
    cmake_host_system_information(RESULT host_cpu QUERY OS_PLATFORM)
    _autolib_platform(host_arch "${host_cpu}" arch)
    set(package_arguments)
    foreach(name IN LISTS packages)
        list(APPEND package_arguments "--package=${name}")
    endforeach()
    set(tool_name "autolib-importer-${host_os}-${host_arch}")
    if(host_os STREQUAL "windows")
        string(APPEND tool_name .exe)
    endif()
    get_property(tool GLOBAL PROPERTY _AUTOLIB_IMPORTER)
    if(NOT tool)
        _autolib_bootstrap_importer(tool "${tool_name}" "${cache}" "${remote}" "${work}")
        set_property(GLOBAL PROPERTY _AUTOLIB_IMPORTER "${tool}")
    endif()
    set(source_arguments)
    if(NOT "${remote}" STREQUAL "")
        list(APPEND source_arguments "--remote-root=${remote}")
    endif()
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    set(request "${work}/.request-${nonce}")
    file(MAKE_DIRECTORY "${request}")
    set(prepare_arguments prepare ${source_arguments} "--cache-root=${cache}"
        "--os=${target_os}" "--arch=${target_arch}" "--result=${request}/result.cmake"
        ${package_arguments})
    get_property(metadata GLOBAL PROPERTY _AUTOLIB_METADATA_ROOT)
    set(metadata_arguments)
    if(NOT "${metadata}" STREQUAL "")
        _autolib_metadata_snapshot(metadata "${remote}" "${work}")
        list(APPEND metadata_arguments "--metadata-root=${metadata}")
    endif()
    execute_process(COMMAND "${tool}" ${prepare_arguments} ${metadata_arguments}
        RESULT_VARIABLE status ERROR_VARIABLE diagnostic)
    if(status STREQUAL "2" AND "${metadata}" STREQUAL "")
        _autolib_metadata_snapshot(metadata "${remote}" "${work}")
        file(REMOVE "${request}/result.cmake")
        execute_process(COMMAND "${tool}" ${prepare_arguments} "--metadata-root=${metadata}"
            RESULT_VARIABLE status ERROR_VARIABLE diagnostic)
    endif()
    if(status STREQUAL "2")
        file(REMOVE_RECURSE "${request}")
        message(FATAL_ERROR "AutoLib importer requested metadata after receiving a snapshot: ${tool}\n${diagnostic}")
    endif()
    if(NOT status STREQUAL "0" OR NOT EXISTS "${request}/result.cmake")
        file(REMOVE_RECURSE "${request}")
        message(FATAL_ERROR "AutoLib importer prepare failed (${status}): ${tool}\n${diagnostic}")
    endif()
    # Result variables are owned by this request, never inherited from an earlier import.
    get_cmake_property(variables VARIABLES)
    foreach(variable IN LISTS variables)
        if(variable MATCHES "^AUTOLIB_PACKAGE_(DIR|VERSION)_")
            set(${variable} "")
        endif()
    endforeach()
    set(AUTOLIB_PREPARED_PACKAGES "")
    include("${request}/result.cmake")
    file(REMOVE_RECURSE "${request}")
    set(seen)
    set(folded_names)
    foreach(name IN LISTS AUTOLIB_PREPARED_PACKAGES)
        _autolib_identifier("${name}" name)
        string(TOLOWER "${name}" folded)
        if(name IN_LIST seen OR folded IN_LIST folded_names)
            message(FATAL_ERROR "AutoLib importer returned invalid or duplicate package: ${name}")
        endif()
        list(APPEND seen "${name}")
        list(APPEND folded_names "${folded}")
        set(directory "${AUTOLIB_PACKAGE_DIR_${name}}")
        set(version "${AUTOLIB_PACKAGE_VERSION_${name}}")
        _autolib_validate_package("${name}" "${version}" "${directory}" "${cache}" "${target_os}" "${target_arch}" dependencies)
        set(dependencies_${name} "${dependencies}")
        get_property(loaded GLOBAL PROPERTY "_AUTOLIB_LOADED_VERSION_${name}")
        if(NOT "${loaded}" STREQUAL "" AND NOT loaded STREQUAL version)
            message(FATAL_ERROR "AutoLib version conflict for ${name}: loaded ${loaded}, result ${version}")
        endif()
    endforeach()
    foreach(reference IN LISTS packages)
        _autolib_package_reference("${reference}" name version)
        if(NOT name IN_LIST seen)
            message(FATAL_ERROR "AutoLib importer result is missing requested package: ${name}")
        endif()
        if(NOT "${version}" STREQUAL "" AND NOT version STREQUAL "${AUTOLIB_PACKAGE_VERSION_${name}}")
            message(FATAL_ERROR "AutoLib importer result version differs from request: ${reference}")
        endif()
    endforeach()
    # Validate the whole result before any adapter can create targets.
    set(prior_packages)
    foreach(name IN LISTS AUTOLIB_PREPARED_PACKAGES)
        set(closure)
        foreach(reference IN LISTS dependencies_${name})
            _autolib_package_reference("${reference}" dependency version)
            if("${version}" STREQUAL "" OR NOT dependency IN_LIST prior_packages OR NOT version STREQUAL "${AUTOLIB_PACKAGE_VERSION_${dependency}}")
                message(FATAL_ERROR "AutoLib result must contain precise dependency ${reference} before ${name}")
            endif()
            list(APPEND closure ${closure_${dependency}})
        endforeach()
        list(APPEND closure "${name}")
        list(REMOVE_DUPLICATES closure)
        set(closure_${name} "${closure}")
        list(APPEND prior_packages "${name}")
    endforeach()
    foreach(name IN LISTS AUTOLIB_PREPARED_PACKAGES)
        set(directory "${AUTOLIB_PACKAGE_DIR_${name}}")
        set(version "${AUTOLIB_PACKAGE_VERSION_${name}}")
        get_property(loaded GLOBAL PROPERTY "_AUTOLIB_LOADED_VERSION_${name}")
        if("${loaded}" STREQUAL "" OR NOT TARGET "autolib::${name}")
            include("${directory}/autolib-import.cmake")
        endif()
        if(NOT TARGET "autolib::${name}")
            message(FATAL_ERROR "AutoLib adapter did not create autolib::${name}: ${directory}")
        endif()
        set_property(GLOBAL PROPERTY "_AUTOLIB_LOADED_VERSION_${name}" "${version}")
        set_property(GLOBAL PROPERTY "_AUTOLIB_PACKAGE_DIR_${name}" "${directory}")
        set_property(GLOBAL PROPERTY "_AUTOLIB_PACKAGE_CLOSURE_${name}" "${closure_${name}}")
        set(AUTOLIB_PACKAGE_DIR_${name} "${directory}" PARENT_SCOPE)
        set(AUTOLIB_PACKAGE_VERSION_${name} "${version}" PARENT_SCOPE)
    endforeach()
    set(targets)
    list(REMOVE_DUPLICATES request_names)
    foreach(name IN LISTS request_names)
        list(APPEND targets "autolib::${name}")
    endforeach()
    target_link_libraries("${consumer}" ${visibility} ${targets})
    foreach(name IN LISTS AUTOLIB_PREPARED_PACKAGES)
        message(STATUS "[Info] [${consumer}] ${name} : ${AUTOLIB_PACKAGE_VERSION_${name}}")
    endforeach()
    set(AUTOLIB_PREPARED_PACKAGES "${AUTOLIB_PREPARED_PACKAGES}" PARENT_SCOPE)
endfunction()

cmake_policy(POP)
