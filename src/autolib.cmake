include_guard(GLOBAL)
cmake_policy(PUSH)
cmake_policy(VERSION 3.20)

if(NOT DEFINED AUTOLIB_LOCAL_ROOT)
    set(AUTOLIB_LOCAL_ROOT "")
endif()
if(NOT DEFINED AUTOLIB_REMOTE_ROOT)
    set(AUTOLIB_REMOTE_ROOT "https://gitee.com/xxf1ow/autolib-release/releases/download/autolib-release")
endif()
file(REAL_PATH "${CMAKE_CURRENT_LIST_FILE}" _autolib_entry)
get_filename_component(_autolib_cache "${_autolib_entry}" DIRECTORY)
if(_autolib_cache MATCHES ";")
    message(FATAL_ERROR "AutoLib cache root must not contain semicolons: ${_autolib_cache}")
endif()
set_property(GLOBAL PROPERTY _AUTOLIB_CACHE_ROOT "${_autolib_cache}")
set(_autolib_local "${AUTOLIB_LOCAL_ROOT}")
if(NOT "${_autolib_local}" STREQUAL "")
    if(_autolib_local MATCHES "^[A-Za-z][A-Za-z0-9+.-]*:" AND NOT _autolib_local MATCHES "^[A-Za-z]:")
        message(FATAL_ERROR "AutoLib AUTOLIB_LOCAL_ROOT must be a filesystem directory: ${_autolib_local}")
    endif()
    get_filename_component(_autolib_local "${_autolib_local}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
    string(REPLACE "\\" "/" _autolib_local "${_autolib_local}")
    if(_autolib_local MATCHES ";")
        message(FATAL_ERROR "AutoLib LOCAL_ROOT must not contain semicolons: ${_autolib_local}")
    endif()
    file(REAL_PATH "${_autolib_local}" _autolib_local)
    if(EXISTS "${_autolib_local}" AND NOT IS_DIRECTORY "${_autolib_local}")
        message(FATAL_ERROR "AutoLib LOCAL_ROOT must be a directory: ${_autolib_local}")
    endif()
    set(_autolib_compare_local "${_autolib_local}")
    set(_autolib_compare_cache "${_autolib_cache}")
    if(CMAKE_HOST_WIN32)
        string(TOLOWER "${_autolib_compare_local}" _autolib_compare_local)
        string(TOLOWER "${_autolib_compare_cache}" _autolib_compare_cache)
    endif()
    if(_autolib_compare_local STREQUAL _autolib_compare_cache)
        message(FATAL_ERROR "AutoLib LOCAL_ROOT and entry cache must not be the same physical directory: ${_autolib_local}")
    endif()
endif()
set_property(GLOBAL PROPERTY _AUTOLIB_LOCAL_ROOT "${_autolib_local}")
set_property(GLOBAL PROPERTY _AUTOLIB_REMOTE_ROOT "${AUTOLIB_REMOTE_ROOT}")
unset(_autolib_local)
unset(_autolib_entry)
unset(_autolib_cache)
unset(_autolib_compare_local)
unset(_autolib_compare_cache)

function(_autolib_platform output value kind)
    string(TOLOWER "${value}" value)
    if(kind STREQUAL "arch")
        if(value MATCHES "^(amd64|x64|x86_64)$")
            set(value x86_64)
        elseif(value MATCHES "^(arm64|aarch64)$")
            set(value aarch64)
        else()
            message(FATAL_ERROR "AutoLib unsupported or unknown architecture '${value}'; configure the CMake target architecture")
        endif()
    elseif(NOT value MATCHES "^(windows|linux)$")
        message(FATAL_ERROR "AutoLib unsupported or unknown OS '${value}'; configure the CMake target OS")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(_autolib_clear_response)
    get_property(directory GLOBAL PROPERTY _AUTOLIB_RESPONSE_DIRECTORY)
    file(REMOVE_RECURSE "${directory}")
endfunction()

function(_autolib_github_json output url path)
    file(DOWNLOAD "${url}" "${path}" TLS_VERIFY ON TIMEOUT 300
        HTTPHEADER "Accept: application/vnd.github+json" STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "AutoLib GitHub request failed: ${url}: ${status}")
    endif()
    file(READ "${path}" body)
    set(${output} "${body}" PARENT_SCOPE)
endfunction()

function(_autolib_release_source remote)
    if(remote MATCHES "^https://([Gg][Ii][Tt][Hh][Uu][Bb][.]com)/([A-Za-z0-9][A-Za-z0-9_.-]*)/([A-Za-z0-9][A-Za-z0-9_.-]*)/releases/tag/([^/?#\" \r\n]+)$")
        set(platform github)
        set(api "https://api.github.com/repos/${CMAKE_MATCH_2}/${CMAKE_MATCH_3}/releases")
        set(encoded_tag "${CMAKE_MATCH_4}")
    elseif(remote MATCHES "^https://([Gg][Ii][Tt][Ee][Ee][.]com)/([A-Za-z0-9][A-Za-z0-9_.-]*)/([A-Za-z0-9][A-Za-z0-9_.-]*)/releases/download/([^/?#\" \r\n]+)$")
        set(platform gitee)
        set(api "https://gitee.com/api/v5/repos/${CMAKE_MATCH_2}/${CMAKE_MATCH_3}/releases")
        set(encoded_tag "${CMAKE_MATCH_4}")
    else()
        message(FATAL_ERROR "AutoLib unsupported remote source: ${remote}")
    endif()
    set(rest "${encoded_tag}")
    set(tag "")
    while(rest MATCHES "^([^%]*)%([0-9A-Fa-f][0-9A-Fa-f])(.*)$")
        set(prefix "${CMAKE_MATCH_1}")
        math(EXPR byte "0x${CMAKE_MATCH_2}")
        set(rest "${CMAKE_MATCH_3}")
        if(byte EQUAL 0 OR byte EQUAL 10 OR byte EQUAL 13)
            message(FATAL_ERROR "AutoLib invalid Release tag: ${encoded_tag}")
        endif()
        string(ASCII ${byte} character)
        string(APPEND tag "${prefix}${character}")
    endwhile()
    if(rest MATCHES "%")
        message(FATAL_ERROR "AutoLib invalid Release tag encoding: ${encoded_tag}")
    endif()
    string(APPEND tag "${rest}")
    foreach(field IN ITEMS platform api encoded_tag tag)
        set(${field} "${${field}}" PARENT_SCOPE)
    endforeach()
endfunction()

# The body index has one fixed schema. Consume its original tokens before
# string(JSON), which accepts duplicate keys and non-JSON syntax on some CMake versions.
function(_autolib_index_token pattern)
    if(NOT rest MATCHES "^[ \t\r\n]*(${pattern})")
        message(FATAL_ERROR "AutoLib invalid Gitee body SHA256 index")
    endif()
    set(token "${CMAKE_MATCH_1}" PARENT_SCOPE)
    string(LENGTH "${CMAKE_MATCH_0}" consumed)
    string(SUBSTRING "${rest}" ${consumed} -1 rest)
    set(rest "${rest}" PARENT_SCOPE)
endfunction()

macro(_autolib_index_string output)
    _autolib_index_token("${string_token}")
    string(JSON ${output} GET "[${token}]" 0)
endmacro()

function(_autolib_gitee_index output body)
    set(start "<!-- autolib-gitee-sync:start -->")
    set(end "<!-- autolib-gitee-sync:end -->")
    foreach(marker IN ITEMS start end)
        string(REGEX MATCHALL "${${marker}}" markers "${body}")
        list(LENGTH markers count)
        if(NOT count EQUAL 1 OR NOT body MATCHES "(^|\n)${${marker}}(\r?\n|$)")
            message(FATAL_ERROR "AutoLib missing or invalid Gitee body SHA256 index markers")
        endif()
    endforeach()
    if(NOT body MATCHES "${start}[ \t\r\n]*```json\r?\n(.*)\r?\n```[ \t\r\n]*${end}")
        message(FATAL_ERROR "AutoLib invalid Gitee body SHA256 index fence")
    endif()
    set(document "${CMAKE_MATCH_1}")
    set(rest "${document}")
    string(ASCII 1 control_first)
    string(ASCII 31 control_last)
    set(string_token "\"([^\"\\\\${control_first}-${control_last}]|\\\\([\"\\\\/bfnrt]|u[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]))*\"")
    _autolib_index_token("\\{")
    _autolib_index_string(key)
    if(NOT key STREQUAL "files")
        message(FATAL_ERROR "AutoLib Gitee index requires only files")
    endif()
    _autolib_index_token(":")
    _autolib_index_token("\\{")
    set(seen)
    if(NOT rest MATCHES "^[ \t\r\n]*\\}")
        while(TRUE)
            _autolib_index_string(name)
            string(SHA256 name_key "${name}")
            if(name STREQUAL "" OR name_key IN_LIST seen)
                message(FATAL_ERROR "AutoLib empty or duplicate Gitee index filename")
            endif()
            list(APPEND seen "${name_key}")
            _autolib_index_token(":")
            _autolib_index_token("\\{")
            set(fields)
            foreach(field_number RANGE 1 2)
                _autolib_index_string(key)
                if(key IN_LIST fields)
                    message(FATAL_ERROR "AutoLib duplicate Gitee index field")
                endif()
                list(APPEND fields "${key}")
                _autolib_index_token(":")
                if(key STREQUAL "sha256")
                    _autolib_index_string(digest)
                    string(LENGTH "${digest}" length)
                    if(NOT length EQUAL 64 OR NOT digest MATCHES "^[0-9A-Fa-f]+$")
                        message(FATAL_ERROR "AutoLib invalid Gitee index SHA256")
                    endif()
                elseif(key STREQUAL "gitee_asset_id")
                    _autolib_index_token("[1-9][0-9]*")
                    string(LENGTH "${token}" length)
                    if(length GREATER 19 OR (length EQUAL 19 AND token STRGREATER "9223372036854775807"))
                        message(FATAL_ERROR "AutoLib invalid Gitee attachment ID")
                    endif()
                else()
                    message(FATAL_ERROR "AutoLib unknown Gitee index field: ${key}")
                endif()
                if(field_number EQUAL 1)
                    _autolib_index_token(",")
                endif()
            endforeach()
            _autolib_index_token("\\}")
            if(rest MATCHES "^[ \t\r\n]*\\}")
                break()
            endif()
            _autolib_index_token(",")
        endwhile()
    endif()
    _autolib_index_token("\\}")
    _autolib_index_token("\\}")
    if(NOT rest MATCHES "^[ \t\r\n]*$")
        message(FATAL_ERROR "AutoLib trailing Gitee index content")
    endif()
    string(JSON kind TYPE "${document}")
    set(${output} "${document}" PARENT_SCOPE)
endfunction()

function(_autolib_gitee_integer output object field)
    string(JSON kind TYPE "${object}" "${field}")
    string(JSON value GET "${object}" "${field}")
    string(LENGTH "${value}" length)
    if(NOT kind STREQUAL "NUMBER" OR NOT value MATCHES "^(0|[1-9][0-9]*)$" OR length GREATER 19 OR (length EQUAL 19 AND value STRGREATER "9223372036854775807"))
        message(FATAL_ERROR "AutoLib Gitee ${field} must be a nonnegative int64")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(_autolib_gitee_select snapshot names)
    set(expected_api "${api}")
    set(expected_tag "${tag}")
    string(JSON actual_platform GET "${snapshot}" platform)
    string(JSON source GET "${snapshot}" source)
    _autolib_release_source("${source}")
    if(NOT actual_platform STREQUAL "gitee" OR NOT platform STREQUAL "gitee" OR NOT api STREQUAL expected_api OR NOT tag STREQUAL expected_tag)
        message(FATAL_ERROR "AutoLib Gitee snapshot platform/source mismatch")
    endif()
    string(JSON release GET "${snapshot}" release)
    _autolib_gitee_integer(id "${release}" id)
    string(JSON actual_tag GET "${release}" tag_name)
    string(JSON body GET "${release}" body)
    if(NOT id MATCHES "^[1-9][0-9]*$" OR NOT actual_tag STREQUAL tag)
        message(FATAL_ERROR "AutoLib Gitee Release ID/tag mismatch")
    endif()
    _autolib_gitee_index(index "${body}")
    string(JSON page_count LENGTH "${snapshot}" pages)
    if(page_count EQUAL 0)
        message(FATAL_ERROR "AutoLib Gitee attachment pages missing")
    endif()
    math(EXPR last_page "${page_count} - 1")
    set(found 0)
    foreach(number RANGE 0 ${last_page})
        string(JSON page GET "${snapshot}" pages ${number})
        string(JSON kind TYPE "${page}")
        string(JSON count LENGTH "${page}")
        if(NOT kind STREQUAL "ARRAY" OR (number LESS last_page AND NOT count EQUAL 100) OR (number EQUAL last_page AND count GREATER_EQUAL 100))
            message(FATAL_ERROR "AutoLib Gitee incomplete attachment pagination")
        endif()
        if(count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(position RANGE 0 ${last})
                string(JSON asset_name GET "${page}" ${position} name)
                if(asset_name IN_LIST names)
                    math(EXPR found "${found} + 1")
                    string(JSON asset GET "${page}" ${position})
                endif()
            endforeach()
        endif()
    endforeach()
    if(NOT found EQUAL 1)
        message(FATAL_ERROR "AutoLib Gitee attachments: expected one candidate, found ${found}")
    endif()
    string(JSON asset_name GET "${asset}" name)
    _autolib_gitee_integer(asset_id "${asset}" id)
    _autolib_gitee_integer(size "${asset}" size)
    string(JSON url GET "${asset}" browser_download_url)
    if(NOT asset_id MATCHES "^[1-9][0-9]*$" OR NOT size MATCHES "^(0|[1-9][0-9]*)$" OR NOT url MATCHES "^https://[^/@ \t\r\n]+(/[^ \t\r\n]*)?$")
        message(FATAL_ERROR "AutoLib invalid Gitee attachment identity or HTTPS URL")
    endif()
    string(JSON expected_id GET "${index}" files "${asset_name}" gitee_asset_id)
    string(JSON digest GET "${index}" files "${asset_name}" sha256)
    if(NOT expected_id STREQUAL asset_id)
        message(FATAL_ERROR "AutoLib Gitee attachment ID differs from SHA256 index")
    endif()
    string(TOLOWER "${digest}" digest)
    foreach(field IN ITEMS asset_name asset_id url digest)
        set(${field} "${${field}}" PARENT_SCOPE)
    endforeach()
endfunction()

function(_autolib_gitee_tool remote archive_name response_file)
    _autolib_release_source("${remote}")
    file(DOWNLOAD "${api}/tags/${encoded_tag}" "${response_file}.part" TLS_VERIFY ON TIMEOUT 300 HTTPHEADER "Accept: application/json" STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "AutoLib Gitee Release request failed: ${status}")
    endif()
    file(READ "${response_file}.part" release)
    _autolib_gitee_integer(id "${release}" id)
    string(JSON actual_tag GET "${release}" tag_name)
    string(JSON body GET "${release}" body)
    if(NOT id MATCHES "^[1-9][0-9]*$" OR NOT actual_tag STREQUAL tag)
        message(FATAL_ERROR "AutoLib Gitee Release ID/tag mismatch")
    endif()
    _autolib_gitee_index(index "${body}")
    set(pages "[]")
    set(number 1)
    while(TRUE)
        file(DOWNLOAD "${api}/${id}/attach_files?page=${number}&per_page=100" "${response_file}.part" TLS_VERIFY ON TIMEOUT 300 HTTPHEADER "Accept: application/json" STATUS status)
        list(GET status 0 code)
        if(NOT code EQUAL 0)
            message(FATAL_ERROR "AutoLib Gitee attachment request failed: ${status}")
        endif()
        file(READ "${response_file}.part" page)
        string(JSON kind TYPE "${page}")
        string(JSON count LENGTH "${page}")
        if(NOT kind STREQUAL "ARRAY" OR count GREATER 100)
            message(FATAL_ERROR "AutoLib invalid Gitee attachment page")
        endif()
        math(EXPR position "${number} - 1")
        string(JSON pages SET "${pages}" ${position} "${page}")
        if(count LESS 100)
            break()
        endif()
        math(EXPR number "${number} + 1")
    endwhile()
    string(JSON snapshot SET "{}" platform "\"gitee\"")
    # The source URL is already validated; JSON escaping also covers encoded tags.
    string(REPLACE "\\" "\\\\" source "${remote}")
    string(REPLACE "\"" "\\\"" source "${source}")
    string(JSON snapshot SET "${snapshot}" source "\"${source}\"")
    string(JSON snapshot SET "${snapshot}" release "${release}")
    string(JSON snapshot SET "${snapshot}" pages "${pages}")
    _autolib_gitee_select("${snapshot}" "${archive_name}")
    file(WRITE "${response_file}.part" "${snapshot}")
    file(RENAME "${response_file}.part" "${response_file}")
    set(url "${url}" PARENT_SCOPE)
    set(digest "${digest}" PARENT_SCOPE)
    set(accept "application/octet-stream" PARENT_SCOPE)
endfunction()

function(_autolib_github_tool remote archive_name response_file)
    _autolib_release_source("${remote}")
    _autolib_github_json(release "${api}/tags/${encoded_tag}" "${response_file}.part")
    string(JSON id GET "${release}" id)
    string(JSON actual_tag GET "${release}" tag_name)
    string(JSON draft GET "${release}" draft)
    string(JSON assets_url GET "${release}" assets_url)
    if(NOT id MATCHES "^[1-9][0-9]*$" OR draft OR NOT actual_tag STREQUAL tag OR NOT assets_url STREQUAL "${api}/${id}/assets")
        message(FATAL_ERROR "AutoLib GitHub Release is draft, incomplete or mismatched: ${remote}")
    endif()
    set(pages "[]")
    set(page_number 1)
    set(found 0)
    while(TRUE)
        _autolib_github_json(page "${assets_url}?per_page=100&page=${page_number}" "${response_file}.part")
        string(JSON kind TYPE "${page}")
        if(NOT kind STREQUAL "ARRAY")
            message(FATAL_ERROR "AutoLib GitHub assets response must be an array")
        endif()
        string(JSON count LENGTH "${page}")
        if(count GREATER 100)
            message(FATAL_ERROR "AutoLib GitHub assets response exceeds page size")
        endif()
        math(EXPR index "${page_number} - 1")
        string(JSON pages SET "${pages}" ${index} "${page}")
        if(count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(index RANGE 0 ${last})
                string(JSON asset_name GET "${page}" ${index} name)
                if(asset_name STREQUAL archive_name)
                    math(EXPR found "${found} + 1")
                    string(JSON asset GET "${page}" ${index})
                endif()
            endforeach()
        endif()
        if(count LESS 100)
            break()
        endif()
        math(EXPR page_number "${page_number} + 1")
    endwhile()
    if(NOT found EQUAL 1)
        message(FATAL_ERROR "AutoLib GitHub tool ${archive_name}: expected one candidate, found ${found}")
    endif()
    string(JSON asset_id GET "${asset}" id)
    string(JSON state GET "${asset}" state)
    string(JSON digest GET "${asset}" digest)
    string(LENGTH "${digest}" digest_length)
    if(NOT asset_id MATCHES "^[1-9][0-9]*$" OR NOT state STREQUAL "uploaded" OR NOT digest_length EQUAL 71 OR NOT digest MATCHES "^sha256:[0-9A-Fa-f]+$")
        message(FATAL_ERROR "AutoLib GitHub tool ${archive_name}: invalid ID, upload state or SHA256")
    endif()
    string(SUBSTRING "${digest}" 7 -1 digest)
    string(JSON snapshot SET "{}" platform "\"github\"")
    string(JSON snapshot SET "${snapshot}" source "\"${remote}\"")
    string(JSON snapshot SET "${snapshot}" release "${release}")
    string(JSON snapshot SET "${snapshot}" pages "${pages}")
    file(WRITE "${response_file}.part" "${snapshot}")
    file(RENAME "${response_file}.part" "${response_file}")
    set(url "${api}/assets/${asset_id}" PARENT_SCOPE)
    set(digest "${digest}" PARENT_SCOPE)
    set(accept "application/octet-stream" PARENT_SCOPE)
endfunction()

function(_autolib_bootstrap_importer output name source cache)
    set(tool "${cache}/${name}")
    if(EXISTS "${tool}" OR IS_SYMLINK "${tool}")
        if(IS_DIRECTORY "${tool}" OR IS_SYMLINK "${tool}")
            message(FATAL_ERROR "AutoLib cached importer must be a regular program: ${tool}")
        endif()
        set(${output} "${tool}" PARENT_SCOPE)
        return()
    endif()
    set(bare "${source}/${name}")
    set(archive "${bare}.tar.xz")
    if("${source}" STREQUAL "" OR (NOT EXISTS "${bare}" AND NOT IS_SYMLINK "${bare}" AND NOT EXISTS "${archive}" AND NOT IS_SYMLINK "${archive}"))
        message(FATAL_ERROR "AutoLib importer missing from entry cache and local source: ${name}; remote bootstrap is unavailable")
    endif()
    if(EXISTS "${bare}" OR IS_SYMLINK "${bare}")
        if(IS_DIRECTORY "${bare}" OR IS_SYMLINK "${bare}")
            message(FATAL_ERROR "AutoLib source importer must be a regular program: ${bare}")
        endif()
    else()
        if(IS_DIRECTORY "${archive}" OR IS_SYMLINK "${archive}")
            message(FATAL_ERROR "AutoLib importer archive must be a regular file: ${archive}")
        endif()
        if(EXISTS "${archive}.sha256" OR IS_SYMLINK "${archive}.sha256")
            if(IS_DIRECTORY "${archive}.sha256" OR IS_SYMLINK "${archive}.sha256")
                message(FATAL_ERROR "AutoLib importer archive SHA256 must be a regular file: ${archive}.sha256")
            endif()
            file(READ "${archive}.sha256" digest)
            string(REGEX REPLACE "\n$" "" digest "${digest}")
            string(LENGTH "${digest}" length)
            if(NOT length EQUAL 64 OR NOT digest MATCHES "^[0-9a-f]+$")
                message(FATAL_ERROR "AutoLib importer archive requires one lowercase SHA256: ${archive}.sha256")
            endif()
            file(SHA256 "${archive}" actual)
            if(NOT actual STREQUAL digest)
                message(FATAL_ERROR "AutoLib importer archive SHA256 mismatch: ${archive}")
            endif()
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${archive}"
            RESULT_VARIABLE status OUTPUT_VARIABLE members ERROR_VARIABLE diagnostic)
        if(NOT status STREQUAL "0" OR NOT "${diagnostic}" STREQUAL "" OR NOT members STREQUAL "${name}\n")
            message(FATAL_ERROR "AutoLib importer archive must contain only the program ${name}: ${archive}\n${diagnostic}")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tvf "${archive}"
            RESULT_VARIABLE status OUTPUT_VARIABLE details ERROR_VARIABLE diagnostic)
        if(NOT status STREQUAL "0" OR NOT "${diagnostic}" STREQUAL "" OR NOT details MATCHES "^-")
            message(FATAL_ERROR "AutoLib importer archive member must be a regular program: ${archive}\n${diagnostic}")
        endif()
    endif()
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    set(staging "${cache}/.tool-${nonce}")
    file(MAKE_DIRECTORY "${staging}")
    if(EXISTS "${bare}")
        configure_file("${bare}" "${staging}/${name}" COPYONLY)
    else()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${archive}"
            WORKING_DIRECTORY "${staging}" RESULT_VARIABLE status ERROR_VARIABLE diagnostic)
        # CMake can report truncated input on stderr while returning zero.
        if(NOT status STREQUAL "0" OR NOT "${diagnostic}" STREQUAL "")
            file(REMOVE_RECURSE "${staging}")
            message(FATAL_ERROR "AutoLib importer archive extraction failed: ${archive}\n${diagnostic}")
        endif()
    endif()
    if(NOT EXISTS "${staging}/${name}" OR IS_DIRECTORY "${staging}/${name}" OR IS_SYMLINK "${staging}/${name}")
        file(REMOVE_RECURSE "${staging}")
        message(FATAL_ERROR "AutoLib importer archive is missing regular program ${name}: ${archive}")
    endif()
    if(NOT CMAKE_HOST_WIN32)
        file(CHMOD "${staging}/${name}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E rename "${staging}/${name}" "${tool}" RESULT_VARIABLE status ERROR_VARIABLE diagnostic)
    file(REMOVE_RECURSE "${staging}")
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "AutoLib cannot cache importer ${tool}: ${diagnostic}")
    endif()
    set(${output} "${tool}" PARENT_SCOPE)
endfunction()

function(_autolib_identifier value kind)
    string(TOUPPER "${value}" upper)
    string(REGEX REPLACE "\\..*$" "" stem "${upper}")
    if(NOT value MATCHES "^[A-Za-z0-9][A-Za-z0-9_.+\\-]*$" OR value MATCHES "\\.$" OR stem MATCHES "^(CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])$" OR (kind STREQUAL "version" AND upper STREQUAL "PACKAGE.TOML"))
        message(FATAL_ERROR "AutoLib invalid package ${kind}: '${value}'")
    endif()
endfunction()

function(_autolib_package_reference reference name_output version_output)
    if(NOT reference MATCHES "^([^@]+)(@([^@]+))?$")
        message(FATAL_ERROR "AutoLib invalid package reference: '${reference}'")
    endif()
    set(name "${CMAKE_MATCH_1}")
    set(version "${CMAKE_MATCH_3}")
    _autolib_identifier("${name}" name)
    if(NOT "${version}" STREQUAL "")
        _autolib_identifier("${version}" version)
    endif()
    set(${name_output} "${name}" PARENT_SCOPE)
    set(${version_output} "${version}" PARENT_SCOPE)
endfunction()

function(_autolib_validate_package name version directory cache target_os target_arch dependencies_output)
    _autolib_identifier("${name}" name)
    _autolib_identifier("${version}" version)
    set(expected "${cache}/${name}/${version}")
    if(NOT IS_ABSOLUTE "${directory}" OR directory MATCHES ";" OR NOT directory STREQUAL expected OR NOT EXISTS "${directory}/autolib-import.cmake" OR IS_DIRECTORY "${directory}/autolib-import.cmake")
        message(FATAL_ERROR "AutoLib importer returned invalid package directory: ${directory}; expected ${expected}")
    endif()
    file(REAL_PATH "${directory}/autolib-import.cmake" actual)
    if(NOT actual STREQUAL "${expected}/autolib-import.cmake")
        message(FATAL_ERROR "AutoLib package directory escapes its entry cache location: ${directory}")
    endif()
    file(GLOB entries RELATIVE "${cache}/${name}" "${cache}/${name}/*")
    set(folded_versions)
    foreach(entry IN LISTS entries)
        if(entry STREQUAL "package.toml")
            continue()
        endif()
        string(TOLOWER "${entry}" folded)
        if(folded IN_LIST folded_versions)
            message(FATAL_ERROR "AutoLib case-colliding package versions in ${cache}/${name}: ${entry}")
        endif()
        list(APPEND folded_versions "${folded}")
    endforeach()
    file(READ "${directory}/autolib-import.cmake" header)
    if(NOT header MATCHES "^set\\(AUTOLIB_PACKAGE_NAME \"([^\"]*)\"\\)\r?\nset\\(AUTOLIB_PACKAGE_VERSION \"([^\"]*)\"\\)\r?\nset\\(AUTOLIB_OS \"([^\"]*)\"\\)\r?\nset\\(AUTOLIB_ARCH \"([^\"]*)\"\\)\r?\nset\\(AUTOLIB_DEPENDENCIES \"([^\"]*)\"\\)(\r?\n|$)")
        message(FATAL_ERROR "AutoLib package metadata requires fixed name/version/os/arch/dependencies header: ${directory}")
    endif()
    set(actual_name "${CMAKE_MATCH_1}")
    set(actual_version "${CMAKE_MATCH_2}")
    set(actual_os "${CMAKE_MATCH_3}")
    set(actual_arch "${CMAKE_MATCH_4}")
    set(dependencies "${CMAKE_MATCH_5}")
    if(NOT actual_name STREQUAL name OR NOT actual_version STREQUAL version OR NOT ((actual_os STREQUAL target_os AND actual_arch STREQUAL target_arch) OR (actual_os STREQUAL "any" AND actual_arch STREQUAL "any")))
        message(FATAL_ERROR "AutoLib package metadata identity differs from result or target: ${name}@${version} in ${directory}")
    endif()
    set(${dependencies_output} "${dependencies}" PARENT_SCOPE)
endfunction()

function(autolib_import)
    if(ARGC LESS 4 OR NOT ARGV0 STREQUAL "TARGET" OR NOT ARGV2 MATCHES "^(PRIVATE|PUBLIC|INTERFACE)$")
        message(FATAL_ERROR "Usage: autolib_import(TARGET <existing target> <PRIVATE|PUBLIC|INTERFACE> <packages...>); legacy source and platform arguments are not supported")
    endif()
    set(consumer "${ARGV1}")
    set(visibility "${ARGV2}")
    if(NOT TARGET "${consumer}")
        message(FATAL_ERROR "AutoLib consumer target does not exist: ${consumer}")
    endif()
    set(packages)
    set(request_names)
    set(reused_packages)
    set(need_prepare FALSE)
    math(EXPR last "${ARGC} - 1")
    foreach(index RANGE 3 ${last})
        set(reference "${ARGV${index}}")
        _autolib_package_reference("${reference}" name version)
        if(name MATCHES "^(TARGET|PRIVATE|PUBLIC|INTERFACE|LOCAL_ROOT|REMOTE_ROOT|PACKAGES|WORK_ROOT|TARGET_OS|TARGET_ARCH|URI)$")
            message(FATAL_ERROR "AutoLib invalid package or unsupported argument: '${reference}'")
        endif()
        get_property(loaded GLOBAL PROPERTY "_AUTOLIB_LOADED_VERSION_${name}")
        if(NOT "${loaded}" STREQUAL "" AND NOT "${version}" STREQUAL "" AND NOT loaded STREQUAL version)
            message(FATAL_ERROR "AutoLib version conflict for ${name}: loaded ${loaded}, requested ${version}")
        endif()
        if("${loaded}" STREQUAL "")
            set(need_prepare TRUE)
        else()
            get_property(closure GLOBAL PROPERTY "_AUTOLIB_PACKAGE_CLOSURE_${name}")
            list(APPEND reused_packages ${closure})
        endif()
        list(APPEND packages "${reference}")
        list(APPEND request_names "${name}")
    endforeach()
    list(REMOVE_DUPLICATES packages)
    get_property(source GLOBAL PROPERTY _AUTOLIB_LOCAL_ROOT)
    get_property(remote GLOBAL PROPERTY _AUTOLIB_REMOTE_ROOT)
    get_property(cache GLOBAL PROPERTY _AUTOLIB_CACHE_ROOT)
    get_filename_component(work "${CMAKE_BINARY_DIR}/autolib" ABSOLUTE)
    string(REPLACE "\\" "/" work "${work}")
    if(work MATCHES ";")
        message(FATAL_ERROR "AutoLib WORK_ROOT must not contain semicolons: ${work}")
    endif()
    set(target_cpu "${CMAKE_SYSTEM_PROCESSOR}")
    if(CMAKE_GENERATOR_PLATFORM)
        string(REGEX REPLACE ",.*$" "" target_cpu "${CMAKE_GENERATOR_PLATFORM}")
    endif()
    _autolib_platform(target_os "${CMAKE_SYSTEM_NAME}" os)
    _autolib_platform(target_arch "${target_cpu}" arch)
    set(identity "${source};${cache};${target_os};${target_arch}")
    get_property(previous GLOBAL PROPERTY _AUTOLIB_CONFIGURE_IDENTITY)
    if(previous AND NOT "${previous}" STREQUAL "${identity}")
        message(FATAL_ERROR "AutoLib requires the same LOCAL_ROOT, entry cache and target platform throughout one configure")
    endif()
    set_property(GLOBAL PROPERTY _AUTOLIB_CONFIGURE_IDENTITY "${identity}")
    if(NOT need_prepare)
        list(REMOVE_DUPLICATES reused_packages)
        foreach(name IN LISTS reused_packages)
            get_property(directory GLOBAL PROPERTY "_AUTOLIB_PACKAGE_DIR_${name}")
            get_property(version GLOBAL PROPERTY "_AUTOLIB_LOADED_VERSION_${name}")
            set(AUTOLIB_PACKAGE_DIR_${name} "${directory}" PARENT_SCOPE)
            set(AUTOLIB_PACKAGE_VERSION_${name} "${version}" PARENT_SCOPE)
        endforeach()
        set(targets)
        list(REMOVE_DUPLICATES request_names)
        foreach(name IN LISTS request_names)
            list(APPEND targets "autolib::${name}")
        endforeach()
        target_link_libraries("${consumer}" ${visibility} ${targets})
        set(AUTOLIB_PREPARED_PACKAGES "${reused_packages}" PARENT_SCOPE)
        return()
    endif()
    _autolib_platform(host_os "${CMAKE_HOST_SYSTEM_NAME}" os)
    cmake_host_system_information(RESULT host_cpu QUERY OS_PLATFORM)
    _autolib_platform(host_arch "${host_cpu}" arch)
    set(package_arguments)
    foreach(name IN LISTS packages)
        list(APPEND package_arguments "--package=${name}")
    endforeach()
    set(tool_name "autolib-importer-${host_os}-${host_arch}")
    if(host_os STREQUAL "windows")
        string(APPEND tool_name .exe)
    endif()
    get_property(tool GLOBAL PROPERTY _AUTOLIB_IMPORTER)
    if(NOT tool)
        _autolib_bootstrap_importer(tool "${tool_name}" "${source}" "${cache}")
        set_property(GLOBAL PROPERTY _AUTOLIB_IMPORTER "${tool}")
    endif()
    set(source_arguments)
    if(NOT "${source}" STREQUAL "")
        list(APPEND source_arguments "--local-root=${source}")
    endif()
    if(NOT "${remote}" STREQUAL "")
        list(APPEND source_arguments "--remote-root=${remote}")
    endif()
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    set(request "${work}/.request-${nonce}")
    file(MAKE_DIRECTORY "${request}")
    execute_process(COMMAND "${tool}" prepare ${source_arguments} "--work-root=${work}"
        "--cache-root=${cache}" "--cmake-command=${CMAKE_COMMAND}"
        "--os=${target_os}" "--arch=${target_arch}" "--result=${request}/result.cmake"
        ${package_arguments}
        RESULT_VARIABLE status ERROR_VARIABLE diagnostic)
    if(NOT status STREQUAL "0" OR NOT EXISTS "${request}/result.cmake")
        file(REMOVE_RECURSE "${request}")
        message(FATAL_ERROR "AutoLib importer prepare failed (${status}): ${tool}\n${diagnostic}")
    endif()
    # Result variables are owned by this request, never inherited from an earlier import.
    get_cmake_property(variables VARIABLES)
    foreach(variable IN LISTS variables)
        if(variable MATCHES "^AUTOLIB_PACKAGE_(DIR|VERSION)_")
            set(${variable} "")
        endif()
    endforeach()
    set(AUTOLIB_PREPARED_PACKAGES "")
    include("${request}/result.cmake")
    file(REMOVE_RECURSE "${request}")
    set(seen)
    set(folded_names)
    foreach(name IN LISTS AUTOLIB_PREPARED_PACKAGES)
        _autolib_identifier("${name}" name)
        string(TOLOWER "${name}" folded)
        if(name IN_LIST seen OR folded IN_LIST folded_names)
            message(FATAL_ERROR "AutoLib importer returned invalid or duplicate package: ${name}")
        endif()
        list(APPEND seen "${name}")
        list(APPEND folded_names "${folded}")
        set(directory "${AUTOLIB_PACKAGE_DIR_${name}}")
        set(version "${AUTOLIB_PACKAGE_VERSION_${name}}")
        _autolib_validate_package("${name}" "${version}" "${directory}" "${cache}" "${target_os}" "${target_arch}" dependencies)
        set(dependencies_${name} "${dependencies}")
        get_property(loaded GLOBAL PROPERTY "_AUTOLIB_LOADED_VERSION_${name}")
        if(NOT "${loaded}" STREQUAL "" AND NOT loaded STREQUAL version)
            message(FATAL_ERROR "AutoLib version conflict for ${name}: loaded ${loaded}, result ${version}")
        endif()
    endforeach()
    foreach(reference IN LISTS packages)
        _autolib_package_reference("${reference}" name version)
        if(NOT name IN_LIST seen)
            message(FATAL_ERROR "AutoLib importer result is missing requested package: ${name}")
        endif()
        if(NOT "${version}" STREQUAL "" AND NOT version STREQUAL "${AUTOLIB_PACKAGE_VERSION_${name}}")
            message(FATAL_ERROR "AutoLib importer result version differs from request: ${reference}")
        endif()
    endforeach()
    # Validate the whole result before any adapter can create targets.
    set(prior_packages)
    foreach(name IN LISTS AUTOLIB_PREPARED_PACKAGES)
        set(closure)
        foreach(reference IN LISTS dependencies_${name})
            _autolib_package_reference("${reference}" dependency version)
            if("${version}" STREQUAL "" OR NOT dependency IN_LIST prior_packages OR NOT version STREQUAL "${AUTOLIB_PACKAGE_VERSION_${dependency}}")
                message(FATAL_ERROR "AutoLib result must contain precise dependency ${reference} before ${name}")
            endif()
            list(APPEND closure ${closure_${dependency}})
        endforeach()
        list(APPEND closure "${name}")
        list(REMOVE_DUPLICATES closure)
        set(closure_${name} "${closure}")
        list(APPEND prior_packages "${name}")
    endforeach()
    foreach(name IN LISTS AUTOLIB_PREPARED_PACKAGES)
        set(directory "${AUTOLIB_PACKAGE_DIR_${name}}")
        set(version "${AUTOLIB_PACKAGE_VERSION_${name}}")
        get_property(loaded GLOBAL PROPERTY "_AUTOLIB_LOADED_VERSION_${name}")
        if("${loaded}" STREQUAL "" OR NOT TARGET "autolib::${name}")
            include("${directory}/autolib-import.cmake")
        endif()
        if(NOT TARGET "autolib::${name}")
            message(FATAL_ERROR "AutoLib adapter did not create autolib::${name}: ${directory}")
        endif()
        set_property(GLOBAL PROPERTY "_AUTOLIB_LOADED_VERSION_${name}" "${version}")
        set_property(GLOBAL PROPERTY "_AUTOLIB_PACKAGE_DIR_${name}" "${directory}")
        set_property(GLOBAL PROPERTY "_AUTOLIB_PACKAGE_CLOSURE_${name}" "${closure_${name}}")
        set(AUTOLIB_PACKAGE_DIR_${name} "${directory}" PARENT_SCOPE)
        set(AUTOLIB_PACKAGE_VERSION_${name} "${version}" PARENT_SCOPE)
    endforeach()
    set(targets)
    list(REMOVE_DUPLICATES request_names)
    foreach(name IN LISTS request_names)
        list(APPEND targets "autolib::${name}")
    endforeach()
    target_link_libraries("${consumer}" ${visibility} ${targets})
    set(AUTOLIB_PREPARED_PACKAGES "${AUTOLIB_PREPARED_PACKAGES}" PARENT_SCOPE)
endfunction()

cmake_policy(POP)
