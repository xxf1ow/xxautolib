include_guard(GLOBAL)
cmake_policy(PUSH)
cmake_policy(VERSION 3.20)

if(NOT DEFINED AUTOLIB_LOCAL_ROOT)
    set(AUTOLIB_LOCAL_ROOT "${PROJECT_SOURCE_DIR}/3rdparty")
endif()
if(NOT DEFINED AUTOLIB_REMOTE_ROOT)
    set(AUTOLIB_REMOTE_ROOT "https://gitee.com/xxf1ow/autolib-release/releases/download/autolib-release")
endif()
if("${AUTOLIB_LOCAL_ROOT}" STREQUAL "" AND "${AUTOLIB_REMOTE_ROOT}" STREQUAL "")
    message(FATAL_ERROR "AutoLib requires at least one local or remote source")
endif()
set(_autolib_local "${AUTOLIB_LOCAL_ROOT}")
if(NOT "${_autolib_local}" STREQUAL "")
    if(_autolib_local MATCHES "^[A-Za-z][A-Za-z0-9+.-]*:" AND NOT _autolib_local MATCHES "^[A-Za-z]:")
        message(FATAL_ERROR "AutoLib AUTOLIB_LOCAL_ROOT must be a filesystem directory: ${_autolib_local}")
    endif()
    get_filename_component(_autolib_local "${_autolib_local}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
    string(REPLACE "\\" "/" _autolib_local "${_autolib_local}")
    if(_autolib_local MATCHES ";")
        message(FATAL_ERROR "AutoLib LOCAL_ROOT must not contain semicolons: ${_autolib_local}")
    endif()
endif()
set_property(GLOBAL PROPERTY _AUTOLIB_LOCAL_ROOT "${_autolib_local}")
set_property(GLOBAL PROPERTY _AUTOLIB_REMOTE_ROOT "${AUTOLIB_REMOTE_ROOT}")
unset(_autolib_local)

function(_autolib_platform output value kind)
    string(TOLOWER "${value}" value)
    if(kind STREQUAL "arch")
        if(value MATCHES "^(amd64|x64|x86_64)$")
            set(value x86_64)
        elseif(value MATCHES "^(arm64|aarch64)$")
            set(value aarch64)
        else()
            message(FATAL_ERROR "AutoLib unsupported or unknown architecture '${value}'; configure the CMake target architecture")
        endif()
    elseif(NOT value MATCHES "^(windows|linux)$")
        message(FATAL_ERROR "AutoLib unsupported or unknown OS '${value}'; configure the CMake target OS")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(autolib_import)
    if(ARGC LESS 4 OR NOT ARGV0 STREQUAL "TARGET" OR NOT ARGV2 MATCHES "^(PRIVATE|PUBLIC|INTERFACE)$")
        message(FATAL_ERROR "Usage: autolib_import(TARGET <existing target> <PRIVATE|PUBLIC|INTERFACE> <packages...>); legacy source and platform arguments are not supported")
    endif()
    set(consumer "${ARGV1}")
    set(visibility "${ARGV2}")
    if(NOT TARGET "${consumer}")
        message(FATAL_ERROR "AutoLib consumer target does not exist: ${consumer}")
    endif()
    set(packages)
    math(EXPR last "${ARGC} - 1")
    foreach(index RANGE 3 ${last})
        set(name "${ARGV${index}}")
        if(NOT name MATCHES "^[A-Za-z0-9][A-Za-z0-9_.+\\-]*$" OR name MATCHES "^(TARGET|PRIVATE|PUBLIC|INTERFACE|LOCAL_ROOT|REMOTE_ROOT|PACKAGES|WORK_ROOT|TARGET_OS|TARGET_ARCH|URI)$")
            message(FATAL_ERROR "AutoLib invalid package or unsupported argument: '${name}'")
        endif()
        list(APPEND packages "${name}")
    endforeach()
    list(REMOVE_DUPLICATES packages)
    get_property(source GLOBAL PROPERTY _AUTOLIB_LOCAL_ROOT)
    get_property(remote GLOBAL PROPERTY _AUTOLIB_REMOTE_ROOT)
    if("${source}" STREQUAL "")
        message(FATAL_ERROR "AutoLib has no local source; remote consumption is not enabled: ${remote}")
    endif()
    get_filename_component(work "${CMAKE_BINARY_DIR}/autolib" ABSOLUTE)
    string(REPLACE "\\" "/" work "${work}")
    if(work MATCHES ";")
        message(FATAL_ERROR "AutoLib WORK_ROOT must not contain semicolons: ${work}")
    endif()
    set(target_cpu "${CMAKE_SYSTEM_PROCESSOR}")
    if(CMAKE_GENERATOR_PLATFORM)
        string(REGEX REPLACE ",.*$" "" target_cpu "${CMAKE_GENERATOR_PLATFORM}")
    endif()
    _autolib_platform(target_os "${CMAKE_SYSTEM_NAME}" os)
    _autolib_platform(target_arch "${target_cpu}" arch)
    set(identity "${source};${work};${target_os};${target_arch}")
    get_property(previous GLOBAL PROPERTY _AUTOLIB_CONFIGURE_IDENTITY)
    if(previous AND NOT "${previous}" STREQUAL "${identity}")
        message(FATAL_ERROR "AutoLib requires the same LOCAL_ROOT, WORK_ROOT and target platform throughout one configure")
    endif()
    set_property(GLOBAL PROPERTY _AUTOLIB_CONFIGURE_IDENTITY "${identity}")
    _autolib_platform(host_os "${CMAKE_HOST_SYSTEM_NAME}" os)
    cmake_host_system_information(RESULT host_cpu QUERY OS_PLATFORM)
    _autolib_platform(host_arch "${host_cpu}" arch)
    set(package_arguments)
    foreach(name IN LISTS packages)
        list(APPEND package_arguments "--package=${name}")
    endforeach()
    set(tool "${source}/autolib-importer-${host_os}-${host_arch}")
    if(host_os STREQUAL "windows")
        string(APPEND tool .exe)
    endif()
    if(NOT EXISTS "${tool}" OR IS_DIRECTORY "${tool}")
        message(FATAL_ERROR "AutoLib local importer missing: ${tool}; remote consumption is not enabled")
    endif()
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    set(request "${work}/.request-${nonce}")
    file(MAKE_DIRECTORY "${request}")
    execute_process(COMMAND "${tool}" prepare "--local-root=${source}" "--work-root=${work}"
        "--os=${target_os}" "--arch=${target_arch}" "--result=${request}/result.cmake"
        ${package_arguments}
        RESULT_VARIABLE status ERROR_VARIABLE diagnostic)
    if(NOT status STREQUAL "0" OR NOT EXISTS "${request}/result.cmake")
        file(REMOVE_RECURSE "${request}")
        message(FATAL_ERROR "AutoLib importer prepare failed (${status}): ${tool}\n${diagnostic}")
    endif()
    # Result variables are owned by this request, never inherited from an earlier import.
    get_cmake_property(variables VARIABLES)
    foreach(variable IN LISTS variables)
        if(variable MATCHES "^AUTOLIB_PACKAGE_DIR_")
            set(${variable} "")
        endif()
    endforeach()
    set(AUTOLIB_PREPARED_PACKAGES "")
    include("${request}/result.cmake")
    file(REMOVE_RECURSE "${request}")
    set(seen)
    foreach(name IN LISTS AUTOLIB_PREPARED_PACKAGES)
        if(NOT name MATCHES "^[A-Za-z0-9][A-Za-z0-9_.+\\-]*$" OR name IN_LIST seen)
            message(FATAL_ERROR "AutoLib importer returned invalid or duplicate package: ${name}")
        endif()
        list(APPEND seen "${name}")
        set(directory "${AUTOLIB_PACKAGE_DIR_${name}}")
        if(NOT IS_ABSOLUTE "${directory}" OR directory MATCHES ";" OR NOT EXISTS "${directory}/autolib-import.cmake")
            message(FATAL_ERROR "AutoLib importer returned invalid package directory: ${directory}")
        endif()
    endforeach()
    foreach(name IN LISTS packages)
        if(NOT name IN_LIST seen)
            message(FATAL_ERROR "AutoLib importer result is missing requested package: ${name}")
        endif()
    endforeach()
    # Validate the whole result before any adapter can create targets.
    foreach(name IN LISTS AUTOLIB_PREPARED_PACKAGES)
        set(directory "${AUTOLIB_PACKAGE_DIR_${name}}")
        include("${directory}/autolib-import.cmake")
        set(AUTOLIB_PACKAGE_DIR_${name} "${directory}" PARENT_SCOPE)
    endforeach()
    set(targets)
    foreach(name IN LISTS packages)
        list(APPEND targets "autolib::${name}")
    endforeach()
    target_link_libraries("${consumer}" ${visibility} ${targets})
    set(AUTOLIB_PREPARED_PACKAGES "${AUTOLIB_PREPARED_PACKAGES}" PARENT_SCOPE)
endfunction()

cmake_policy(POP)
