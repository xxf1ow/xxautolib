include_guard(GLOBAL)
cmake_policy(PUSH)
cmake_policy(VERSION 3.20)

function(_autolib_platform output value kind)
    string(TOLOWER "${value}" value)
    if(kind STREQUAL "arch")
        if(value MATCHES "^(amd64|x64|x86_64)$")
            set(value x86_64)
        elseif(value MATCHES "^(arm64|aarch64)$")
            set(value aarch64)
        else()
            message(FATAL_ERROR "AutoLib unsupported or unknown architecture '${value}'; set TARGET_ARCH explicitly")
        endif()
    elseif(NOT value MATCHES "^(windows|linux)$")
        message(FATAL_ERROR "AutoLib unsupported or unknown OS '${value}'; set TARGET_OS explicitly")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(autolib_import)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "LOCAL_ROOT;REMOTE_ROOT;WORK_ROOT;TARGET_OS;TARGET_ARCH" "PACKAGES")
    if(arg_UNPARSED_ARGUMENTS OR arg_KEYWORDS_MISSING_VALUES OR NOT arg_PACKAGES)
        message(FATAL_ERROR "Usage: autolib_import(LOCAL_ROOT <directory> PACKAGES <names...> [WORK_ROOT <directory>] [TARGET_OS <os>] [TARGET_ARCH <arch>]); URI is not supported")
    endif()
    if(DEFINED arg_REMOTE_ROOT AND NOT "${arg_REMOTE_ROOT}" STREQUAL "")
        message(FATAL_ERROR "AutoLib remote consumption is not enabled: ${arg_REMOTE_ROOT}")
    endif()
    if(NOT DEFINED arg_LOCAL_ROOT OR "${arg_LOCAL_ROOT}" STREQUAL "")
        message(FATAL_ERROR "AutoLib requires LOCAL_ROOT; remote consumption is not enabled")
    endif()
    if(arg_LOCAL_ROOT MATCHES "^[A-Za-z][A-Za-z0-9+.-]*:" AND NOT arg_LOCAL_ROOT MATCHES "^[A-Za-z]:")
        message(FATAL_ERROR "AutoLib LOCAL_ROOT must be a filesystem directory: ${arg_LOCAL_ROOT}")
    endif()
    get_filename_component(source "${arg_LOCAL_ROOT}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
    string(REPLACE "\\" "/" source "${source}")
    if(source MATCHES ";")
        message(FATAL_ERROR "AutoLib LOCAL_ROOT must not contain semicolons: ${source}")
    endif()
    if(NOT DEFINED arg_WORK_ROOT)
        set(arg_WORK_ROOT "${CMAKE_BINARY_DIR}/autolib")
    endif()
    get_filename_component(work "${arg_WORK_ROOT}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
    string(REPLACE "\\" "/" work "${work}")
    if(work MATCHES ";")
        message(FATAL_ERROR "AutoLib WORK_ROOT must not contain semicolons: ${work}")
    endif()
    if(NOT DEFINED arg_TARGET_OS)
        set(arg_TARGET_OS "${CMAKE_SYSTEM_NAME}")
    endif()
    if(NOT DEFINED arg_TARGET_ARCH)
        set(arg_TARGET_ARCH "${CMAKE_SYSTEM_PROCESSOR}")
        if(CMAKE_GENERATOR_PLATFORM)
            string(REGEX REPLACE ",.*$" "" arg_TARGET_ARCH "${CMAKE_GENERATOR_PLATFORM}")
        endif()
    endif()
    _autolib_platform(target_os "${arg_TARGET_OS}" os)
    _autolib_platform(target_arch "${arg_TARGET_ARCH}" arch)
    set(identity "${source};${work};${target_os};${target_arch}")
    get_property(previous GLOBAL PROPERTY _AUTOLIB_CONFIGURE_IDENTITY)
    if(previous AND NOT "${previous}" STREQUAL "${identity}")
        message(FATAL_ERROR "AutoLib requires the same LOCAL_ROOT, WORK_ROOT and target platform throughout one configure")
    endif()
    set_property(GLOBAL PROPERTY _AUTOLIB_CONFIGURE_IDENTITY "${identity}")
    _autolib_platform(host_os "${CMAKE_HOST_SYSTEM_NAME}" os)
    cmake_host_system_information(RESULT host_cpu QUERY OS_PLATFORM)
    _autolib_platform(host_arch "${host_cpu}" arch)
    list(REMOVE_DUPLICATES arg_PACKAGES)
    set(package_arguments)
    foreach(name IN LISTS arg_PACKAGES)
        if(NOT name MATCHES "^[A-Za-z0-9][A-Za-z0-9_.+\\-]*$")
            message(FATAL_ERROR "AutoLib invalid package name: ${name}")
        endif()
        list(APPEND package_arguments "--package=${name}")
    endforeach()
    set(tool "${source}/autolib-importer-${host_os}-${host_arch}")
    if(host_os STREQUAL "windows")
        string(APPEND tool .exe)
    endif()
    if(NOT EXISTS "${tool}" OR IS_DIRECTORY "${tool}")
        message(FATAL_ERROR "AutoLib local importer missing: ${tool}")
    endif()
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    set(request "${work}/.request-${nonce}")
    file(MAKE_DIRECTORY "${request}")
    execute_process(COMMAND "${tool}" prepare "--local-root=${source}" "--work-root=${work}"
        "--os=${target_os}" "--arch=${target_arch}" "--result=${request}/result.cmake"
        ${package_arguments}
        RESULT_VARIABLE status ERROR_VARIABLE diagnostic)
    if(NOT status STREQUAL "0" OR NOT EXISTS "${request}/result.cmake")
        file(REMOVE_RECURSE "${request}")
        message(FATAL_ERROR "AutoLib importer prepare failed (${status}): ${tool}\n${diagnostic}")
    endif()
    # Result variables are owned by this request, never inherited from an earlier import.
    get_cmake_property(variables VARIABLES)
    foreach(variable IN LISTS variables)
        if(variable MATCHES "^AUTOLIB_PACKAGE_DIR_")
            set(${variable} "")
        endif()
    endforeach()
    set(AUTOLIB_PREPARED_PACKAGES "")
    include("${request}/result.cmake")
    file(REMOVE_RECURSE "${request}")
    set(seen)
    foreach(name IN LISTS AUTOLIB_PREPARED_PACKAGES)
        if(NOT name MATCHES "^[A-Za-z0-9][A-Za-z0-9_.+\\-]*$" OR name IN_LIST seen)
            message(FATAL_ERROR "AutoLib importer returned invalid or duplicate package: ${name}")
        endif()
        list(APPEND seen "${name}")
        set(directory "${AUTOLIB_PACKAGE_DIR_${name}}")
        if(NOT IS_ABSOLUTE "${directory}" OR directory MATCHES ";" OR NOT EXISTS "${directory}/autolib-import.cmake")
            message(FATAL_ERROR "AutoLib importer returned invalid package directory: ${directory}")
        endif()
    endforeach()
    foreach(name IN LISTS arg_PACKAGES)
        if(NOT name IN_LIST seen)
            message(FATAL_ERROR "AutoLib importer result is missing requested package: ${name}")
        endif()
    endforeach()
    # Validate the whole result before any adapter can create targets.
    foreach(name IN LISTS AUTOLIB_PREPARED_PACKAGES)
        set(directory "${AUTOLIB_PACKAGE_DIR_${name}}")
        include("${directory}/autolib-import.cmake")
        set(AUTOLIB_PACKAGE_DIR_${name} "${directory}" PARENT_SCOPE)
    endforeach()
    set(AUTOLIB_PREPARED_PACKAGES "${AUTOLIB_PREPARED_PACKAGES}" PARENT_SCOPE)
endfunction()

cmake_policy(POP)
