include_guard(GLOBAL)
cmake_policy(PUSH)
cmake_policy(VERSION 3.20)

function(_autolib_json output action document)
    string(JSON value ERROR_VARIABLE error "${action}" "${document}" ${ARGN})
    if(error)
        message(FATAL_ERROR "AutoLib manifest JSON: ${error}")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(_autolib_platform output value kind)
    string(TOLOWER "${value}" value)
    if(kind STREQUAL "arch")
        if(value MATCHES "^(amd64|x64|x86_64)$")
            set(value x86_64)
        elseif(value MATCHES "^(arm64|aarch64)$")
            set(value aarch64)
        else()
            message(FATAL_ERROR "AutoLib unsupported or unknown architecture '${value}'; set TARGET_ARCH explicitly")
        endif()
    elseif(NOT value MATCHES "^(windows|linux)$")
        message(FATAL_ERROR "AutoLib unsupported or unknown OS '${value}'; set TARGET_OS explicitly")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(_autolib_select_importer document host_os host_arch asset_output digest_output)
    _autolib_json(type TYPE "${document}")
    _autolib_json(count LENGTH "${document}")
    if(NOT type STREQUAL "OBJECT" OR NOT count EQUAL 2)
        message(FATAL_ERROR "AutoLib manifest requires only importers and packages arrays")
    endif()
    foreach(key IN ITEMS importers packages)
        _autolib_json(type TYPE "${document}" "${key}")
        if(NOT type STREQUAL "ARRAY")
            message(FATAL_ERROR "AutoLib manifest ${key} must be an array")
        endif()
    endforeach()
    _autolib_json(count LENGTH "${document}" importers)
    set(slots)
    set(selected FALSE)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            _autolib_json(type TYPE "${document}" importers ${index})
            _autolib_json(fields LENGTH "${document}" importers ${index})
            if(NOT type STREQUAL "OBJECT" OR NOT fields EQUAL 4)
                message(FATAL_ERROR "AutoLib importer record must contain only os, arch, asset and sha256")
            endif()
            foreach(key IN ITEMS os arch asset sha256)
                _autolib_json(type TYPE "${document}" importers ${index} ${key})
                _autolib_json(${key} GET "${document}" importers ${index} ${key})
                if(NOT type STREQUAL "STRING" OR "${${key}}" STREQUAL "")
                    message(FATAL_ERROR "AutoLib importer ${key} must be a nonempty string")
                endif()
            endforeach()
            if(NOT os MATCHES "^(windows|linux)$" OR NOT arch MATCHES "^(x86_64|aarch64)$")
                message(FATAL_ERROR "AutoLib unsupported importer platform ${os}/${arch}")
            endif()
            if(asset MATCHES "[/\\\\:]" OR asset STREQUAL "." OR asset STREQUAL "..")
                message(FATAL_ERROR "AutoLib importer asset must be a single local filename: ${asset}")
            endif()
            string(LENGTH "${sha256}" digest_length)
            if(NOT digest_length EQUAL 64 OR NOT sha256 MATCHES "^[0-9a-fA-F]+$")
                message(FATAL_ERROR "AutoLib importer ${asset} requires a 64-digit hexadecimal SHA256")
            endif()
            set(slot "${os}-${arch}")
            if(slot IN_LIST slots)
                message(FATAL_ERROR "AutoLib duplicate importer slot ${slot}")
            endif()
            list(APPEND slots "${slot}")
            if(os STREQUAL host_os AND arch STREQUAL host_arch)
                set(selected TRUE)
                set(${asset_output} "${asset}" PARENT_SCOPE)
                string(TOLOWER "${sha256}" sha256)
                set(${digest_output} "${sha256}" PARENT_SCOPE)
            endif()
        endforeach()
    endif()
    if(NOT selected)
        message(FATAL_ERROR "AutoLib manifest has no importer for ${host_os}/${host_arch}")
    endif()
endfunction()

function(_autolib_current_manifest source output)
    get_property(fetched GLOBAL PROPERTY _AUTOLIB_MANIFEST_FETCHED)
    if(fetched)
        get_property(document GLOBAL PROPERTY _AUTOLIB_CURRENT_MANIFEST)
    else()
        if(NOT EXISTS "${source}/manifest.json" OR IS_DIRECTORY "${source}/manifest.json")
            message(FATAL_ERROR "AutoLib local manifest missing: ${source}/manifest.json; prepare the complete local release")
        endif()
        file(READ "${source}/manifest.json" document)
        set_property(GLOBAL PROPERTY _AUTOLIB_MANIFEST_FETCHED TRUE)
        set_property(GLOBAL PROPERTY _AUTOLIB_CURRENT_MANIFEST "${document}")
    endif()
    set(${output} "${document}" PARENT_SCOPE)
endfunction()

function(autolib_import)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "URI;WORK_ROOT;TARGET_OS;TARGET_ARCH" "PACKAGES")
    if(arg_UNPARSED_ARGUMENTS OR arg_KEYWORDS_MISSING_VALUES OR NOT DEFINED arg_URI OR NOT arg_PACKAGES)
        message(FATAL_ERROR "Usage: autolib_import(URI <local root> PACKAGES <names...> [WORK_ROOT <directory>] [TARGET_OS <os>] [TARGET_ARCH <arch>])")
    endif()
    if(arg_URI MATCHES "^[A-Za-z][A-Za-z0-9+.-]*:" AND NOT arg_URI MATCHES "^[A-Za-z]:")
        message(FATAL_ERROR "AutoLib only supports local source directories: ${arg_URI}")
    endif()
    get_filename_component(source "${arg_URI}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
    string(REPLACE "\\" "/" source "${source}")
    get_property(previous_source GLOBAL PROPERTY _AUTOLIB_SOURCE)
    if(previous_source AND NOT previous_source STREQUAL source)
        message(FATAL_ERROR "AutoLib requires one source per configure: ${previous_source} versus ${source}")
    endif()
    set_property(GLOBAL PROPERTY _AUTOLIB_SOURCE "${source}")
    string(SHA256 source_key "${source}")
    if(NOT DEFINED arg_WORK_ROOT)
        set(arg_WORK_ROOT "${CMAKE_BINARY_DIR}/autolib")
    endif()
    get_filename_component(work "${arg_WORK_ROOT}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
    string(REPLACE "\\" "/" work "${work}")
    if(work MATCHES ";")
        message(FATAL_ERROR "AutoLib WORK_ROOT must not contain semicolons: ${work}; set WORK_ROOT to a directory without semicolons")
    endif()
    if(NOT DEFINED arg_TARGET_OS)
        set(arg_TARGET_OS "${CMAKE_SYSTEM_NAME}")
    endif()
    if(NOT DEFINED arg_TARGET_ARCH)
        set(arg_TARGET_ARCH "${CMAKE_SYSTEM_PROCESSOR}")
        if(CMAKE_GENERATOR_PLATFORM)
            string(REGEX REPLACE ",.*$" "" arg_TARGET_ARCH "${CMAKE_GENERATOR_PLATFORM}")
        endif()
    endif()
    _autolib_platform(target_os "${arg_TARGET_OS}" os)
    _autolib_platform(target_arch "${arg_TARGET_ARCH}" arch)
    _autolib_platform(host_os "${CMAKE_HOST_SYSTEM_NAME}" os)
    cmake_host_system_information(RESULT host_cpu QUERY OS_PLATFORM)
    _autolib_platform(host_arch "${host_cpu}" arch)
    list(REMOVE_DUPLICATES arg_PACKAGES)
    set(package_arguments)
    set(need_manifest FALSE)
    set(cache "${work}/${source_key}")
    foreach(name IN LISTS arg_PACKAGES)
        if(NOT name MATCHES "^[A-Za-z0-9][A-Za-z0-9_.+\\-]*$")
            message(FATAL_ERROR "AutoLib invalid package name: ${name}")
        endif()
        list(APPEND package_arguments "--package=${name}")
        if(NOT EXISTS "${cache}/packages/${target_os}-${target_arch}/${name}")
            set(need_manifest TRUE)
        endif()
    endforeach()
    set(tool_dir "${cache}/tools/${host_os}-${host_arch}")
    set(tool_name autolib-importer)
    if(host_os STREQUAL "windows")
        string(APPEND tool_name .exe)
    endif()
    set(tool "${tool_dir}/${tool_name}")
    if(EXISTS "${tool_dir}" OR IS_SYMLINK "${tool_dir}")
        if(NOT EXISTS "${tool}" OR NOT EXISTS "${tool_dir}/manifest.json")
            message(FATAL_ERROR "AutoLib incomplete cached importer: ${tool_dir}; preserve or remove this directory before retrying")
        endif()
        file(READ "${tool_dir}/manifest.json" tool_manifest)
        _autolib_select_importer("${tool_manifest}" "${host_os}" "${host_arch}" asset digest)
        file(SHA256 "${tool}" actual)
        if(NOT actual STREQUAL digest)
            message(FATAL_ERROR "AutoLib cached importer SHA256 mismatch: ${tool}; preserve or remove its cache directory")
        endif()
    else()
        _autolib_current_manifest("${source}" tool_manifest)
        _autolib_select_importer("${tool_manifest}" "${host_os}" "${host_arch}" asset digest)
        if(NOT EXISTS "${source}/${asset}" OR IS_DIRECTORY "${source}/${asset}")
            message(FATAL_ERROR "AutoLib local importer missing: ${source}/${asset}")
        endif()
        string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
        set(temporary "${cache}/tools/.prepare-${nonce}")
        file(MAKE_DIRECTORY "${temporary}")
        configure_file("${source}/${asset}" "${temporary}/${tool_name}" COPYONLY)
        file(SHA256 "${temporary}/${tool_name}" actual)
        if(NOT actual STREQUAL digest)
            file(REMOVE_RECURSE "${temporary}")
            message(FATAL_ERROR "AutoLib importer SHA256 mismatch: ${source}/${asset}; expected ${digest}, got ${actual}")
        endif()
        file(WRITE "${temporary}/manifest.json" "${tool_manifest}")
        if(host_os STREQUAL "linux")
            file(CHMOD "${temporary}/${tool_name}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
        endif()
        file(RENAME "${temporary}" "${tool_dir}")
    endif()
    if(need_manifest)
        _autolib_current_manifest("${source}" current_manifest)
    endif()
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    set(request "${cache}/.request-${nonce}")
    file(MAKE_DIRECTORY "${request}")
    set(manifest_argument)
    get_property(fetched GLOBAL PROPERTY _AUTOLIB_MANIFEST_FETCHED)
    if(fetched)
        get_property(current_manifest GLOBAL PROPERTY _AUTOLIB_CURRENT_MANIFEST)
        file(WRITE "${request}/manifest.json" "${current_manifest}")
        string(REPLACE ";" "\\;" manifest_argument "--manifest=${request}/manifest.json")
    endif()
    execute_process(COMMAND "${tool}" prepare "--uri=${source}" "--work-root=${work}"
        "--os=${target_os}" "--arch=${target_arch}" "--result=${request}/result.cmake"
        ${manifest_argument} ${package_arguments}
        RESULT_VARIABLE status ERROR_VARIABLE diagnostic)
    if(NOT status STREQUAL "0" OR NOT EXISTS "${request}/result.cmake")
        file(REMOVE_RECURSE "${request}")
        message(FATAL_ERROR "AutoLib importer prepare failed (${status}): ${tool}\n${diagnostic}")
    endif()
    include("${request}/result.cmake")
    file(REMOVE_RECURSE "${request}")
    if(NOT AUTOLIB_PREPARED_PACKAGES STREQUAL arg_PACKAGES)
        message(FATAL_ERROR "AutoLib importer result does not match requested packages")
    endif()
    foreach(name IN LISTS AUTOLIB_PREPARED_PACKAGES)
        set(directory "${AUTOLIB_PACKAGE_DIR_${name}}")
        if(NOT IS_ABSOLUTE "${directory}" OR NOT EXISTS "${directory}/autolib-import.cmake")
            message(FATAL_ERROR "AutoLib importer returned invalid package directory: ${directory}")
        endif()
        include("${directory}/autolib-import.cmake")
        set(AUTOLIB_PACKAGE_DIR_${name} "${directory}" PARENT_SCOPE)
    endforeach()
    set(AUTOLIB_PREPARED_PACKAGES "${AUTOLIB_PREPARED_PACKAGES}" PARENT_SCOPE)
endfunction()

cmake_policy(POP)
