include_guard(GLOBAL)
cmake_policy(PUSH)
cmake_policy(VERSION 3.20)

if(NOT DEFINED AUTOLIB_LOCAL_ROOT)
    set(AUTOLIB_LOCAL_ROOT "${PROJECT_SOURCE_DIR}/3rdparty")
endif()
if(NOT DEFINED AUTOLIB_REMOTE_ROOT)
    set(AUTOLIB_REMOTE_ROOT "https://gitee.com/xxf1ow/autolib-release/releases/download/autolib-release")
endif()
if("${AUTOLIB_LOCAL_ROOT}" STREQUAL "" AND "${AUTOLIB_REMOTE_ROOT}" STREQUAL "")
    message(FATAL_ERROR "AutoLib requires at least one local or remote source")
endif()
set(_autolib_local "${AUTOLIB_LOCAL_ROOT}")
if(NOT "${_autolib_local}" STREQUAL "")
    if(_autolib_local MATCHES "^[A-Za-z][A-Za-z0-9+.-]*:" AND NOT _autolib_local MATCHES "^[A-Za-z]:")
        message(FATAL_ERROR "AutoLib AUTOLIB_LOCAL_ROOT must be a filesystem directory: ${_autolib_local}")
    endif()
    get_filename_component(_autolib_local "${_autolib_local}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
    string(REPLACE "\\" "/" _autolib_local "${_autolib_local}")
    if(_autolib_local MATCHES ";")
        message(FATAL_ERROR "AutoLib LOCAL_ROOT must not contain semicolons: ${_autolib_local}")
    endif()
endif()
set_property(GLOBAL PROPERTY _AUTOLIB_LOCAL_ROOT "${_autolib_local}")
set_property(GLOBAL PROPERTY _AUTOLIB_REMOTE_ROOT "${AUTOLIB_REMOTE_ROOT}")
unset(_autolib_local)

function(_autolib_platform output value kind)
    string(TOLOWER "${value}" value)
    if(kind STREQUAL "arch")
        if(value MATCHES "^(amd64|x64|x86_64)$")
            set(value x86_64)
        elseif(value MATCHES "^(arm64|aarch64)$")
            set(value aarch64)
        else()
            message(FATAL_ERROR "AutoLib unsupported or unknown architecture '${value}'; configure the CMake target architecture")
        endif()
    elseif(NOT value MATCHES "^(windows|linux)$")
        message(FATAL_ERROR "AutoLib unsupported or unknown OS '${value}'; configure the CMake target OS")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(_autolib_clear_response)
    get_property(directory GLOBAL PROPERTY _AUTOLIB_RESPONSE_DIRECTORY)
    file(REMOVE_RECURSE "${directory}")
endfunction()

function(_autolib_github_json output url path)
    file(DOWNLOAD "${url}" "${path}" TLS_VERIFY ON TIMEOUT 300
        HTTPHEADER "Accept: application/vnd.github+json" STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "AutoLib GitHub request failed: ${url}: ${status}")
    endif()
    file(READ "${path}" body)
    set(${output} "${body}" PARENT_SCOPE)
endfunction()

function(_autolib_bootstrap_importer output remote name local_root work response_file)
    set(archive_name "${name}.tar.xz")
    set(archive "${local_root}/${archive_name}")
    if("${local_root}" STREQUAL "" OR NOT EXISTS "${archive}")
        if("${remote}" STREQUAL "")
            message(FATAL_ERROR "AutoLib local importer and archive missing and remote source is disabled: ${name}")
        endif()
        if(NOT remote MATCHES "^https://github[.]com/([A-Za-z0-9][A-Za-z0-9_.-]*)/([A-Za-z0-9][A-Za-z0-9_.-]*)/releases/tag/([^/?#\"; \r\n]+)$")
            message(FATAL_ERROR "AutoLib unsupported remote source; expected a public GitHub Release tag URL: ${remote}")
        endif()
        set(api "https://api.github.com/repos/${CMAKE_MATCH_1}/${CMAKE_MATCH_2}/releases")
        set(encoded_tag "${CMAKE_MATCH_3}")
        set(rest "${encoded_tag}")
        set(tag "")
        while(rest MATCHES "^([^%]*)%([0-9A-Fa-f][0-9A-Fa-f])(.*)$")
            set(prefix "${CMAKE_MATCH_1}")
            math(EXPR byte "0x${CMAKE_MATCH_2}")
            set(rest "${CMAKE_MATCH_3}")
            if(byte EQUAL 0 OR byte EQUAL 10 OR byte EQUAL 13)
                message(FATAL_ERROR "AutoLib invalid GitHub tag: ${encoded_tag}")
            endif()
            string(ASCII ${byte} character)
            string(APPEND tag "${prefix}${character}")
        endwhile()
        if(rest MATCHES "%")
            message(FATAL_ERROR "AutoLib invalid GitHub tag encoding: ${encoded_tag}")
        endif()
        string(APPEND tag "${rest}")
        _autolib_github_json(release "${api}/tags/${encoded_tag}" "${response_file}.part")
        string(JSON id GET "${release}" id)
        string(JSON actual_tag GET "${release}" tag_name)
        string(JSON draft GET "${release}" draft)
        string(JSON assets_url GET "${release}" assets_url)
        if(NOT id MATCHES "^[1-9][0-9]*$" OR draft OR NOT actual_tag STREQUAL tag OR NOT assets_url STREQUAL "${api}/${id}/assets")
            message(FATAL_ERROR "AutoLib GitHub Release is draft, incomplete or mismatched: ${remote}")
        endif()
        set(pages "[]")
        set(page_number 1)
        set(found 0)
        while(TRUE)
            _autolib_github_json(page "${assets_url}?per_page=100&page=${page_number}" "${response_file}.part")
            string(JSON kind TYPE "${page}")
            if(NOT kind STREQUAL "ARRAY")
                message(FATAL_ERROR "AutoLib GitHub assets response must be an array")
            endif()
            string(JSON count LENGTH "${page}")
            if(count GREATER 100)
                message(FATAL_ERROR "AutoLib GitHub assets response exceeds page size")
            endif()
            math(EXPR index "${page_number} - 1")
            string(JSON pages SET "${pages}" ${index} "${page}")
            if(count GREATER 0)
                math(EXPR last "${count} - 1")
                foreach(index RANGE 0 ${last})
                    string(JSON asset_name GET "${page}" ${index} name)
                    if(asset_name STREQUAL archive_name)
                        math(EXPR found "${found} + 1")
                        string(JSON asset GET "${page}" ${index})
                    endif()
                endforeach()
            endif()
            if(count LESS 100)
                break()
            endif()
            math(EXPR page_number "${page_number} + 1")
        endwhile()
        if(NOT found EQUAL 1)
            message(FATAL_ERROR "AutoLib GitHub tool ${archive_name}: expected one candidate, found ${found}")
        endif()
        string(JSON asset_id GET "${asset}" id)
        string(JSON state GET "${asset}" state)
        string(JSON digest GET "${asset}" digest)
        string(LENGTH "${digest}" digest_length)
        if(NOT asset_id MATCHES "^[1-9][0-9]*$" OR NOT state STREQUAL "uploaded" OR NOT digest_length EQUAL 71 OR NOT digest MATCHES "^sha256:[0-9A-Fa-f]+$")
            message(FATAL_ERROR "AutoLib GitHub tool ${archive_name}: invalid ID, upload state or SHA256")
        endif()
        string(SUBSTRING "${digest}" 7 -1 digest)
        string(JSON snapshot SET "{}" source "\"${remote}\"")
        string(JSON snapshot SET "${snapshot}" release "${release}")
        string(JSON snapshot SET "${snapshot}" pages "${pages}")
        file(WRITE "${response_file}.part" "${snapshot}")
        file(RENAME "${response_file}.part" "${response_file}")
        include(FetchContent)
        FetchContent_Declare(autolib_importer
            URL "${api}/assets/${asset_id}" URL_HASH "SHA256=${digest}"
            HTTP_HEADER "Accept: application/octet-stream" TLS_VERIFY ON TIMEOUT 300
            DOWNLOAD_NO_EXTRACT TRUE SOURCE_DIR "${work}/bootstrap"
            DOWNLOAD_NAME "${archive_name}")
        FetchContent_MakeAvailable(autolib_importer)
        set(archive "${work}/bootstrap/${archive_name}")
    endif()
    if(IS_DIRECTORY "${archive}")
        message(FATAL_ERROR "AutoLib importer archive must be a file: ${archive}")
    endif()
    get_filename_component(extracted "${response_file}" DIRECTORY)
    string(APPEND extracted "/importer")
    file(MAKE_DIRECTORY "${extracted}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${archive}"
        WORKING_DIRECTORY "${extracted}" RESULT_VARIABLE status ERROR_VARIABLE diagnostic)
    # CMake can report truncated input on stderr while returning zero.
    if(NOT status STREQUAL "0" OR NOT "${diagnostic}" STREQUAL "")
        file(REMOVE_RECURSE "${extracted}")
        message(FATAL_ERROR "AutoLib importer archive extraction failed: ${archive}\n${diagnostic}")
    endif()
    set(tool "${extracted}/${name}")
    if(NOT EXISTS "${tool}" OR IS_DIRECTORY "${tool}")
        file(REMOVE_RECURSE "${extracted}")
        message(FATAL_ERROR "AutoLib importer archive is missing program ${name}: ${archive}")
    endif()
    file(CHMOD "${tool}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    if(NOT "${local_root}" STREQUAL "")
        file(COPY "${tool}" DESTINATION "${local_root}")
        set(tool "${local_root}/${name}")
        file(REMOVE_RECURSE "${extracted}")
    endif()
    set(${output} "${tool}" PARENT_SCOPE)
endfunction()

function(autolib_import)
    if(ARGC LESS 4 OR NOT ARGV0 STREQUAL "TARGET" OR NOT ARGV2 MATCHES "^(PRIVATE|PUBLIC|INTERFACE)$")
        message(FATAL_ERROR "Usage: autolib_import(TARGET <existing target> <PRIVATE|PUBLIC|INTERFACE> <packages...>); legacy source and platform arguments are not supported")
    endif()
    set(consumer "${ARGV1}")
    set(visibility "${ARGV2}")
    if(NOT TARGET "${consumer}")
        message(FATAL_ERROR "AutoLib consumer target does not exist: ${consumer}")
    endif()
    set(packages)
    math(EXPR last "${ARGC} - 1")
    foreach(index RANGE 3 ${last})
        set(name "${ARGV${index}}")
        if(NOT name MATCHES "^[A-Za-z0-9][A-Za-z0-9_.+\\-]*$" OR name MATCHES "^(TARGET|PRIVATE|PUBLIC|INTERFACE|LOCAL_ROOT|REMOTE_ROOT|PACKAGES|WORK_ROOT|TARGET_OS|TARGET_ARCH|URI)$")
            message(FATAL_ERROR "AutoLib invalid package or unsupported argument: '${name}'")
        endif()
        list(APPEND packages "${name}")
    endforeach()
    list(REMOVE_DUPLICATES packages)
    get_property(source GLOBAL PROPERTY _AUTOLIB_LOCAL_ROOT)
    get_property(remote GLOBAL PROPERTY _AUTOLIB_REMOTE_ROOT)
    get_filename_component(work "${CMAKE_BINARY_DIR}/autolib" ABSOLUTE)
    string(REPLACE "\\" "/" work "${work}")
    if(work MATCHES ";")
        message(FATAL_ERROR "AutoLib WORK_ROOT must not contain semicolons: ${work}")
    endif()
    set(target_cpu "${CMAKE_SYSTEM_PROCESSOR}")
    if(CMAKE_GENERATOR_PLATFORM)
        string(REGEX REPLACE ",.*$" "" target_cpu "${CMAKE_GENERATOR_PLATFORM}")
    endif()
    _autolib_platform(target_os "${CMAKE_SYSTEM_NAME}" os)
    _autolib_platform(target_arch "${target_cpu}" arch)
    set(identity "${source};${work};${target_os};${target_arch}")
    get_property(previous GLOBAL PROPERTY _AUTOLIB_CONFIGURE_IDENTITY)
    if(previous AND NOT "${previous}" STREQUAL "${identity}")
        message(FATAL_ERROR "AutoLib requires the same LOCAL_ROOT, WORK_ROOT and target platform throughout one configure")
    endif()
    set_property(GLOBAL PROPERTY _AUTOLIB_CONFIGURE_IDENTITY "${identity}")
    _autolib_platform(host_os "${CMAKE_HOST_SYSTEM_NAME}" os)
    cmake_host_system_information(RESULT host_cpu QUERY OS_PLATFORM)
    _autolib_platform(host_arch "${host_cpu}" arch)
    set(package_arguments)
    foreach(name IN LISTS packages)
        list(APPEND package_arguments "--package=${name}")
    endforeach()
    set(tool_name "autolib-importer-${host_os}-${host_arch}")
    if(host_os STREQUAL "windows")
        string(APPEND tool_name .exe)
    endif()
    get_property(response_directory GLOBAL PROPERTY _AUTOLIB_RESPONSE_DIRECTORY)
    if(NOT response_directory)
        string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
        set(response_directory "${work}/.response-${nonce}")
        file(MAKE_DIRECTORY "${response_directory}")
        set_property(GLOBAL PROPERTY _AUTOLIB_RESPONSE_DIRECTORY "${response_directory}")
        cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _autolib_clear_response)
    endif()
    set(response_file "${response_directory}/github.json")
    get_property(tool GLOBAL PROPERTY _AUTOLIB_IMPORTER)
    if(NOT tool)
        set(tool "${source}/${tool_name}")
        if("${source}" STREQUAL "" OR NOT EXISTS "${tool}")
            _autolib_bootstrap_importer(tool "${remote}" "${tool_name}" "${source}" "${work}" "${response_file}")
        elseif(IS_DIRECTORY "${tool}")
            message(FATAL_ERROR "AutoLib importer must be a file: ${tool}")
        endif()
        set_property(GLOBAL PROPERTY _AUTOLIB_IMPORTER "${tool}")
    endif()
    set(source_arguments "--github-response=${response_file}")
    if(NOT "${source}" STREQUAL "")
        list(APPEND source_arguments "--local-root=${source}")
    endif()
    if(NOT "${remote}" STREQUAL "")
        list(APPEND source_arguments "--remote-root=${remote}")
    endif()
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    set(request "${work}/.request-${nonce}")
    file(MAKE_DIRECTORY "${request}")
    execute_process(COMMAND "${tool}" prepare ${source_arguments} "--work-root=${work}"
        "--os=${target_os}" "--arch=${target_arch}" "--result=${request}/result.cmake"
        ${package_arguments}
        RESULT_VARIABLE status ERROR_VARIABLE diagnostic)
    if(NOT status STREQUAL "0" OR NOT EXISTS "${request}/result.cmake")
        file(REMOVE_RECURSE "${request}")
        message(FATAL_ERROR "AutoLib importer prepare failed (${status}): ${tool}\n${diagnostic}")
    endif()
    # Result variables are owned by this request, never inherited from an earlier import.
    get_cmake_property(variables VARIABLES)
    foreach(variable IN LISTS variables)
        if(variable MATCHES "^AUTOLIB_PACKAGE_DIR_")
            set(${variable} "")
        endif()
    endforeach()
    set(AUTOLIB_PREPARED_PACKAGES "")
    include("${request}/result.cmake")
    file(REMOVE_RECURSE "${request}")
    set(seen)
    foreach(name IN LISTS AUTOLIB_PREPARED_PACKAGES)
        if(NOT name MATCHES "^[A-Za-z0-9][A-Za-z0-9_.+\\-]*$" OR name IN_LIST seen)
            message(FATAL_ERROR "AutoLib importer returned invalid or duplicate package: ${name}")
        endif()
        list(APPEND seen "${name}")
        set(directory "${AUTOLIB_PACKAGE_DIR_${name}}")
        if(NOT IS_ABSOLUTE "${directory}" OR directory MATCHES ";" OR NOT EXISTS "${directory}/autolib-import.cmake")
            message(FATAL_ERROR "AutoLib importer returned invalid package directory: ${directory}")
        endif()
    endforeach()
    foreach(name IN LISTS packages)
        if(NOT name IN_LIST seen)
            message(FATAL_ERROR "AutoLib importer result is missing requested package: ${name}")
        endif()
    endforeach()
    # Validate the whole result before any adapter can create targets.
    foreach(name IN LISTS AUTOLIB_PREPARED_PACKAGES)
        set(directory "${AUTOLIB_PACKAGE_DIR_${name}}")
        include("${directory}/autolib-import.cmake")
        set(AUTOLIB_PACKAGE_DIR_${name} "${directory}" PARENT_SCOPE)
    endforeach()
    set(targets)
    foreach(name IN LISTS packages)
        list(APPEND targets "autolib::${name}")
    endforeach()
    target_link_libraries("${consumer}" ${visibility} ${targets})
    set(AUTOLIB_PREPARED_PACKAGES "${AUTOLIB_PREPARED_PACKAGES}" PARENT_SCOPE)
endfunction()

cmake_policy(POP)
