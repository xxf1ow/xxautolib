function(xxautolib_prepare_go executable_output environment_output)
    get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." ABSOLUTE)
    file(STRINGS "${root}/go.mod" go_directive REGEX "^go [0-9]+\\.[0-9]+\\.[0-9]+$")
    if(NOT go_directive)
        message(FATAL_ERROR "go.mod must pin a full Go SDK version: ${root}/go.mod")
    endif()
    string(REGEX REPLACE "^go " "" required_go "${go_directive}")
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/go-sdk-versions.cmake")
    if(NOT required_go STREQUAL xxautolib_go_version)
        message(FATAL_ERROR "Go SDK metadata mismatch: go.mod requires ${required_go}; update go-sdk-versions.cmake and its official digests")
    endif()

    string(TOLOWER "${CMAKE_HOST_SYSTEM_NAME}" host_os)
    cmake_host_system_information(RESULT host_arch QUERY OS_PLATFORM)
    string(TOLOWER "${host_arch}" host_arch)
    if(host_arch MATCHES "^(amd64|x86_64|x64)$")
        set(host_arch amd64)
    elseif(host_arch MATCHES "^(aarch64|arm64)$")
        set(host_arch arm64)
    endif()
    set(host "${host_os}-${host_arch}")
    if(host STREQUAL "windows-amd64")
        set(extension zip)
        set(executable_suffix .exe)
    elseif(host MATCHES "^linux-(amd64|arm64)$")
        set(extension tar.gz)
        set(executable_suffix "")
    else()
        message(FATAL_ERROR "Go SDK unsupported host: ${host}; supported: windows-amd64, linux-amd64, linux-arm64")
    endif()
    set(digest "${xxautolib_go_sha256_${host_os}_${host_arch}}")
    set(tools "${root}/.tools/go")
    set(sdk_parent "${tools}/sdk/go${required_go}/${host}")
    set(sdk_root "${sdk_parent}/go")
    set(go_executable "${sdk_root}/bin/go${executable_suffix}")
    set(go_environment "${CMAKE_COMMAND}" -E env
        "GOENV=off" "GOWORK=off" "GOFLAGS=" "GOTOOLCHAIN=local" "CGO_ENABLED=0"
        "GOROOT=${sdk_root}" "GOPATH=${tools}/gopath" "GOMODCACHE=${tools}/gopath/pkg/mod"
        "GOCACHE=${tools}/gocache" "GOOS=${host_os}" "GOARCH=${host_arch}")
    file(MAKE_DIRECTORY "${tools}")
    file(LOCK "${tools}/sdk.lock" GUARD FUNCTION TIMEOUT 120)
    if(NOT EXISTS "${go_executable}")
        if(EXISTS "${sdk_root}")
            message(FATAL_ERROR "Go SDK incomplete: ${sdk_root}; preserve any local changes and remove this SDK directory before retrying")
        endif()
        set(asset "go${required_go}.${host}.${extension}")
        set(archive "${tools}/downloads/${asset}")
        set(url "${xxautolib_go_base_url}/${asset}")
        file(MAKE_DIRECTORY "${tools}/downloads" "${sdk_parent}")
        if(NOT EXISTS "${archive}")
            message(STATUS "Preparing Go SDK ${required_go} (${host}): ${url}")
            file(DOWNLOAD "${url}" "${archive}.part" TLS_VERIFY ON STATUS download_status
                TIMEOUT 300 INACTIVITY_TIMEOUT 30)
            list(GET download_status 0 download_code)
            if(NOT download_code EQUAL 0)
                message(FATAL_ERROR "Go SDK download failed: ${url}\n${download_status}\nCache: ${archive}; connect to the network and retry")
            endif()
            file(SHA256 "${archive}.part" actual_digest)
            if(NOT actual_digest STREQUAL digest)
                message(FATAL_ERROR "Go SDK SHA256 mismatch: ${url}\nExpected: ${digest}\nActual: ${actual_digest}\nIncomplete download: ${archive}.part")
            endif()
            file(RENAME "${archive}.part" "${archive}")
        else()
            file(SHA256 "${archive}" actual_digest)
            if(NOT actual_digest STREQUAL digest)
                message(FATAL_ERROR "Go SDK cached archive SHA256 mismatch: ${archive}; remove this archive and retry")
            endif()
        endif()
        string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef temporary_id)
        set(staging "${sdk_parent}/unpack-${temporary_id}")
        file(MAKE_DIRECTORY "${staging}")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${archive}"
            WORKING_DIRECTORY "${staging}" RESULT_VARIABLE extraction_result ERROR_VARIABLE extraction_error)
        if(NOT extraction_result STREQUAL "0")
            message(FATAL_ERROR "Go SDK extraction failed: ${archive}\n${extraction_error}\nTemporary directory: ${staging}")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env "GOENV=off" "GOTOOLCHAIN=local" "GOROOT=${staging}/go"
            "${staging}/go/bin/go${executable_suffix}" version RESULT_VARIABLE sdk_result
            OUTPUT_VARIABLE sdk_version ERROR_VARIABLE sdk_error OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT sdk_result STREQUAL "0" OR NOT sdk_version STREQUAL "go version go${required_go} ${host_os}/${host_arch}")
            message(FATAL_ERROR "Go SDK archive cannot execute the required version: ${archive}\n${sdk_version}\n${sdk_error}\nTemporary directory: ${staging}")
        endif()
        file(RENAME "${staging}/go" "${sdk_root}")
        file(REMOVE_RECURSE "${staging}")
    endif()
    execute_process(COMMAND ${go_environment} "${go_executable}" version
        WORKING_DIRECTORY "${root}" RESULT_VARIABLE sdk_result
        OUTPUT_VARIABLE sdk_version ERROR_VARIABLE sdk_error OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT sdk_result STREQUAL "0")
        message(FATAL_ERROR "Go SDK cannot execute: ${go_executable}\n${sdk_error}")
    endif()
    if(NOT sdk_version STREQUAL "go version go${required_go} ${host_os}/${host_arch}")
        message(FATAL_ERROR "Go SDK version mismatch: require ${required_go} (${host}); ${go_executable}: ${sdk_version}")
    endif()
    set(${executable_output} "${go_executable}" PARENT_SCOPE)
    set(${environment_output} "${go_environment}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    set(arguments)
    set(after_separator FALSE)
    math(EXPR last_argument "${CMAKE_ARGC} - 1")
    foreach(index RANGE 0 ${last_argument})
        if(after_separator)
            list(APPEND arguments "${CMAKE_ARGV${index}}")
        elseif(CMAKE_ARGV${index} STREQUAL "--")
            set(after_separator TRUE)
        endif()
    endforeach()
    if(NOT arguments)
        message(FATAL_ERROR "Usage: cmake -P src/autolib-builder/go-sdk.cmake -- <go command> [arguments...]")
    endif()
    xxautolib_prepare_go(go_executable go_environment)
    get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
    execute_process(COMMAND ${go_environment} "${go_executable}" ${arguments}
        WORKING_DIRECTORY "${root}" RESULT_VARIABLE command_result)
    if(NOT command_result STREQUAL "0")
        message(FATAL_ERROR "Project Go command failed: ${command_result}")
    endif()
endif()
