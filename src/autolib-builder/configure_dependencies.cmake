# 只为当前模块配置设置查找环境；原生 CMake 的非零结果必须传回 ExternalProject。
foreach(required SETUP_FILE SOURCE_DIR BINARY_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "configure_dependencies: missing ${required}")
    endif()
endforeach()
include("${SETUP_FILE}")
if(NOT "${_al_pkgconfig}" STREQUAL "")
    if(NOT "$ENV{PKG_CONFIG_PATH}" STREQUAL "")
        if(CMAKE_HOST_WIN32)
            string(APPEND _al_pkgconfig ";$ENV{PKG_CONFIG_PATH}")
        else()
            string(APPEND _al_pkgconfig ":$ENV{PKG_CONFIG_PATH}")
        endif()
    endif()
    set(ENV{PKG_CONFIG_PATH} "${_al_pkgconfig}")
endif()
string(REPLACE "<SOURCE_DIR>" "${SOURCE_DIR}" _al_command "${_al_command}")
string(REPLACE "<BINARY_DIR>" "${BINARY_DIR}" _al_command "${_al_command}")
execute_process(COMMAND ${_al_command} RESULT_VARIABLE result)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Dependency configure failed for ${SOURCE_DIR}: ${result}")
endif()
