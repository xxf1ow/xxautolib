# Auto detect text files and perform LF normalization
*        text=auto

# Repository metadata and extensionless text files
.gitattributes text eol=lf
.gitignore     text eol=lf
.python-version text eol=lf
LICENSE         text eol=lf
uv.lock         text eol=lf

# Linux scripts, documentation, and configuration
*.bash   text eol=lf
*.conf   text eol=lf
*.cmake  text eol=lf
*.hcl    text eol=lf
*.ini    text eol=lf
*.json   text eol=lf
*.jsonc  text eol=lf
*.md     text eol=lf
# Unified diffs require a space on empty context lines.
*.patch  text eol=lf whitespace=-blank-at-eol
*.py     text eol=lf
*.sh     text eol=lf
*.toml   text eol=lf
*.txt    text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf

# Future Windows scripts
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf
*.psd1     text eol=crlf
*.psm1     text eol=crlf
*.reg      text eol=crlf

# Binary resources that Skills may carry
*.gif  binary
*.ico  binary
*.jpeg binary
*.jpg  binary
*.pdf  binary
*.png  binary
*.webp binary
*.zip  binary
